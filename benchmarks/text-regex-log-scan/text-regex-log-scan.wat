(module
  ;; 112.5 MiB holds the exact 100 MiB fixture, descriptors, and bounded captures.
  (memory (export "memory") 1800 1800)
  (global $candidate (mut i32) (i32.const 0))
  (global $prefix (mut i32) (i32.const 0))
  (global $tail (mut i32) (i32.const 0))

  (func $digit (param $b i32) (result i32)
    (i32.and (i32.ge_u (local.get $b) (i32.const 48))
             (i32.le_u (local.get $b) (i32.const 57))))

  (func $url_char (param $b i32) (result i32)
    (i32.or
      (i32.or
        (i32.and (i32.ge_u (local.get $b) (i32.const 97))
                 (i32.le_u (local.get $b) (i32.const 122)))
        (i32.and (i32.ge_u (local.get $b) (i32.const 48))
                 (i32.le_u (local.get $b) (i32.const 57))))
      (i32.or
        (i32.or (i32.eq (local.get $b) (i32.const 46))
                (i32.eq (local.get $b) (i32.const 47)))
        (i32.or (i32.eq (local.get $b) (i32.const 95))
                (i32.eq (local.get $b) (i32.const 45))))))

  (func $match_url (param $ptr i32) (param $len i32) (param $cursor_in i32) (result i32)
    (local $cursor i32) (local $start i32) (local $b i32)
    (local.set $cursor (local.get $cursor_in))
    (local.set $start (local.get $cursor_in))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $cursor) (local.get $len)))
        (br_if $done (i32.ge_u (i32.sub (local.get $cursor) (local.get $start)) (i32.const 96)))
        (local.set $b (i32.load8_u (i32.add (local.get $ptr) (local.get $cursor))))
        (global.set $tail (i32.add (global.get $tail) (i32.const 1)))
        (br_if $done (i32.eqz (call $url_char (local.get $b))))
        (local.set $cursor (i32.add (local.get $cursor) (i32.const 1)))
        (br $loop)))
    (if (i32.eq (local.get $cursor) (local.get $start)) (then (return (i32.const -1))))
    (if (i32.and
          (i32.eq (i32.sub (local.get $cursor) (local.get $start)) (i32.const 96))
          (i32.lt_u (local.get $cursor) (local.get $len)))
      (then
        (local.set $b (i32.load8_u (i32.add (local.get $ptr) (local.get $cursor))))
        (global.set $tail (i32.add (global.get $tail) (i32.const 1)))
        (if (call $url_char (local.get $b)) (then (return (i32.const -1))))))
    (local.get $cursor))

  (func $match_status (param $ptr i32) (param $len i32) (param $cursor i32) (result i32)
    (local $i i32) (local $b i32) (local $value i32) (local $end i32)
    (if (i32.gt_u (i32.add (local.get $cursor) (i32.const 3)) (local.get $len))
      (then (return (i32.const -1))))
    (local.set $i (i32.const 0))
    (local.set $value (i32.const 0))
    (block $digits_done
      (loop $digits
        (br_if $digits_done (i32.ge_u (local.get $i) (i32.const 3)))
        (local.set $b (i32.load8_u (i32.add (local.get $ptr)
          (i32.add (local.get $cursor) (local.get $i)))))
        (global.set $tail (i32.add (global.get $tail) (i32.const 1)))
        (if (i32.eqz (call $digit (local.get $b))) (then (return (i32.const -1))))
        (local.set $value (i32.add (i32.mul (local.get $value) (i32.const 10))
          (i32.sub (local.get $b) (i32.const 48))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $digits)))
    (if (i32.or (i32.lt_u (local.get $value) (i32.const 100))
                (i32.gt_u (local.get $value) (i32.const 599)))
      (then (return (i32.const -1))))
    (local.set $end (i32.add (local.get $cursor) (i32.const 3)))
    (if (i32.lt_u (local.get $end) (local.get $len))
      (then
        (local.set $b (i32.load8_u (i32.add (local.get $ptr) (local.get $end))))
        (global.set $tail (i32.add (global.get $tail) (i32.const 1)))
        (if (call $digit (local.get $b)) (then (return (i32.const -1))))))
    (local.get $end))

  (func $match_ipv4 (param $ptr i32) (param $len i32) (param $cursor_in i32) (result i32)
    (local $cursor i32) (local $octet i32) (local $start i32)
    (local $digits i32) (local $value i32) (local $b i32)
    (local.set $cursor (local.get $cursor_in))
    (local.set $octet (i32.const 0))
    (block $octets_done
      (loop $octets
        (br_if $octets_done (i32.ge_u (local.get $octet) (i32.const 4)))
        (local.set $start (local.get $cursor))
        (local.set $digits (i32.const 0))
        (local.set $value (i32.const 0))
        (block $digits_done
          (loop $digits_loop
            (br_if $digits_done (i32.ge_u (local.get $cursor) (local.get $len)))
            (br_if $digits_done (i32.ge_u (local.get $digits) (i32.const 3)))
            (local.set $b (i32.load8_u (i32.add (local.get $ptr) (local.get $cursor))))
            (global.set $tail (i32.add (global.get $tail) (i32.const 1)))
            (br_if $digits_done (i32.eqz (call $digit (local.get $b))))
            (local.set $value (i32.add (i32.mul (local.get $value) (i32.const 10))
              (i32.sub (local.get $b) (i32.const 48))))
            (local.set $cursor (i32.add (local.get $cursor) (i32.const 1)))
            (local.set $digits (i32.add (local.get $digits) (i32.const 1)))
            (br $digits_loop)))
        (if (i32.or
              (i32.eqz (local.get $digits))
              (i32.or
                (i32.gt_u (local.get $value) (i32.const 255))
                (i32.and (i32.gt_u (local.get $digits) (i32.const 1))
                  (i32.eq (i32.load8_u (i32.add (local.get $ptr) (local.get $start)))
                          (i32.const 48)))))
          (then (return (i32.const -1))))
        (if (i32.lt_u (local.get $octet) (i32.const 3))
          (then
            (if (i32.ge_u (local.get $cursor) (local.get $len))
              (then (return (i32.const -1))))
            (local.set $b (i32.load8_u (i32.add (local.get $ptr) (local.get $cursor))))
            (global.set $tail (i32.add (global.get $tail) (i32.const 1)))
            (if (i32.ne (local.get $b) (i32.const 46))
              (then (return (i32.const -1))))
            (local.set $cursor (i32.add (local.get $cursor) (i32.const 1)))))
        (local.set $octet (i32.add (local.get $octet) (i32.const 1)))
        (br $octets)))
    (if (i32.lt_u (local.get $cursor) (local.get $len))
      (then
        (local.set $b (i32.load8_u (i32.add (local.get $ptr) (local.get $cursor))))
        (global.set $tail (i32.add (global.get $tail) (i32.const 1)))
        (if (i32.or (call $digit (local.get $b)) (i32.eq (local.get $b) (i32.const 46)))
          (then (return (i32.const -1))))))
    (local.get $cursor))

  (func (export "scan_patterns")
    (param $input i32) (param $len i32) (param $desc i32) (param $pattern_count i32)
    (param $dispatch_offset i32) (param $dispatch_count i32) (param $dispatch_items i32)
    (param $out i32) (param $capacity i32) (result i32)
    (local $pos i32) (local $byte i32) (local $offset i32) (local $count i32)
    (local $candidate_index i32) (local $pattern_index i32) (local $descriptor i32)
    (local $prefix_ptr i32) (local $prefix_len i32) (local $class i32)
    (local $k i32) (local $ok i32) (local $end i32) (local $matches i32)
    (global.set $candidate (i32.const 0))
    (global.set $prefix (i32.const 0))
    (global.set $tail (i32.const 0))
    (local.set $pos (i32.const 0))
    (local.set $matches (i32.const 0))
    (block $scan_done
      (loop $positions
        (br_if $scan_done (i32.ge_u (local.get $pos) (local.get $len)))
        (local.set $byte (i32.load8_u (i32.add (local.get $input) (local.get $pos))))
        (local.set $offset (i32.load (i32.add (local.get $dispatch_offset)
          (i32.shl (local.get $byte) (i32.const 2)))))
        (local.set $count (i32.load (i32.add (local.get $dispatch_count)
          (i32.shl (local.get $byte) (i32.const 2)))))
        (local.set $candidate_index (i32.const 0))
        (block $candidates_done
          (loop $candidates
            (br_if $candidates_done
              (i32.ge_u (local.get $candidate_index) (local.get $count)))
            (local.set $pattern_index (i32.load (i32.add (local.get $dispatch_items)
              (i32.shl (i32.add (local.get $offset) (local.get $candidate_index)) (i32.const 2)))))
            (if (i32.ge_u (local.get $pattern_index) (local.get $pattern_count))
              (then (return (i32.const -1))))
            (global.set $candidate (i32.add (global.get $candidate) (i32.const 1)))
            (local.set $descriptor (i32.add (local.get $desc)
              (i32.shl (local.get $pattern_index) (i32.const 4))))
            (local.set $prefix_ptr (i32.load offset=4 (local.get $descriptor)))
            (local.set $prefix_len (i32.load offset=8 (local.get $descriptor)))
            (local.set $class (i32.load offset=12 (local.get $descriptor)))
            (local.set $k (i32.const 0))
            (local.set $ok (i32.const 1))
            (block $prefix_done
              (loop $prefix_loop
                (br_if $prefix_done (i32.ge_u (local.get $k) (local.get $prefix_len)))
                (if (i32.ge_u (i32.add (local.get $pos) (local.get $k)) (local.get $len))
                  (then (local.set $ok (i32.const 0)) (br $prefix_done)))
                (global.set $prefix (i32.add (global.get $prefix) (i32.const 1)))
                (if (i32.ne
                      (i32.load8_u (i32.add (local.get $input)
                        (i32.add (local.get $pos) (local.get $k))))
                      (i32.load8_u (i32.add (local.get $prefix_ptr) (local.get $k))))
                  (then (local.set $ok (i32.const 0)) (br $prefix_done)))
                (local.set $k (i32.add (local.get $k) (i32.const 1)))
                (br $prefix_loop)))
            (if (local.get $ok)
              (then
                (local.set $end
                  (if (result i32) (i32.eq (local.get $class) (i32.const 1))
                    (then (call $match_url (local.get $input) (local.get $len)
                      (i32.add (local.get $pos) (local.get $prefix_len))))
                    (else
                      (if (result i32) (i32.eq (local.get $class) (i32.const 2))
                        (then (call $match_ipv4 (local.get $input) (local.get $len)
                          (i32.add (local.get $pos) (local.get $prefix_len))))
                        (else (call $match_status (local.get $input) (local.get $len)
                          (i32.add (local.get $pos) (local.get $prefix_len))))))))
                (if (i32.ge_s (local.get $end) (i32.const 0))
                  (then
                    (if (i32.lt_u (local.get $matches) (local.get $capacity))
                      (then
                        (i32.store (i32.add (local.get $out)
                          (i32.add (i32.const 16)
                            (i32.mul (local.get $matches) (i32.const 12))))
                          (i32.load (local.get $descriptor)))
                        (i32.store (i32.add (local.get $out)
                          (i32.add (i32.const 20)
                            (i32.mul (local.get $matches) (i32.const 12))))
                          (local.get $pos))
                        (i32.store (i32.add (local.get $out)
                          (i32.add (i32.const 24)
                            (i32.mul (local.get $matches) (i32.const 12))))
                          (local.get $end))))
                    (local.set $matches (i32.add (local.get $matches) (i32.const 1)))))))
            (local.set $candidate_index
              (i32.add (local.get $candidate_index) (i32.const 1)))
            (br $candidates)))
        (local.set $pos (i32.add (local.get $pos) (i32.const 1)))
        (br $positions)))
    (i32.store (local.get $out) (local.get $matches))
    (i32.store offset=4 (local.get $out) (global.get $candidate))
    (i32.store offset=8 (local.get $out) (global.get $prefix))
    (i32.store offset=12 (local.get $out) (global.get $tail))
    (local.get $matches))
)

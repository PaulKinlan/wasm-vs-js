(module
  (memory (export "memory") 64)
  (global $w (mut i32) (i32.const 0)) (global $cap (mut i32) (i32.const 0))
  (data (i32.const 0) "<nav aria-label=\22Table of contents\22><ol>")
  (data (i32.const 48) "</ol></nav>")
  (data (i32.const 64) "<li><a href=\22#") (data (i32.const 80) "\22>")
  (data (i32.const 84) "</a></li>")
  (data (i32.const 96) "<h1 id=\22") (data (i32.const 108) "<h2 id=\22")
  (data (i32.const 120) "</h1>") (data (i32.const 128) "</h2>")
  (data (i32.const 136) "<p>") (data (i32.const 144) "</p>")
  (data (i32.const 152) "<p><a href=\22") (data (i32.const 168) "</a></p>")
  (data (i32.const 180) "<figure><img src=\22") (data (i32.const 200) "\22 alt=\22")
  (data (i32.const 208) "\22></figure>")
  (data (i32.const 224) "&amp;") (data (i32.const 232) "&lt;")
  (data (i32.const 240) "&gt;") (data (i32.const 248) "&quot;")
  (data (i32.const 264) "section")
  (data (i32.const 280) "https://example.test/")
  (data (i32.const 304) "https://docs.example.test/")
  (data (i32.const 336) "https://images.example.test/")

  (func $put (param $v i32)
    (if (i32.ge_u (global.get $w) (global.get $cap)) (then unreachable))
    (i32.store8 (global.get $w) (local.get $v))
    (global.set $w (i32.add (global.get $w) (i32.const 1))))
  (func $lit (param $p i32) (param $n i32) (local $i i32)
    (block $done (loop $loop (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
      (call $put (i32.load8_u (i32.add (local.get $p) (local.get $i))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $loop))))
  (func $escaped (param $p i32) (param $n i32) (local $i i32) (local $c i32)
    (block $done (loop $loop (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
      (local.set $c (i32.load8_u (i32.add (local.get $p) (local.get $i))))
      (if (i32.eq (local.get $c) (i32.const 38)) (then (call $lit (i32.const 224) (i32.const 5)))
      (else (if (i32.eq (local.get $c) (i32.const 60)) (then (call $lit (i32.const 232) (i32.const 4)))
      (else (if (i32.eq (local.get $c) (i32.const 62)) (then (call $lit (i32.const 240) (i32.const 4)))
      (else (if (i32.eq (local.get $c) (i32.const 34)) (then (call $lit (i32.const 248) (i32.const 6)))
      (else (call $put (local.get $c))))))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $loop))))
  (func $slug (param $p i32) (param $n i32) (local $i i32) (local $c i32) (local $any i32) (local $dash i32)
    (block $done (loop $loop (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
      (local.set $c (i32.load8_u (i32.add (local.get $p) (local.get $i))))
      (if (i32.or (i32.and (i32.ge_u (local.get $c) (i32.const 65)) (i32.le_u (local.get $c) (i32.const 90)))
                   (i32.or (i32.and (i32.ge_u (local.get $c) (i32.const 97)) (i32.le_u (local.get $c) (i32.const 122)))
                           (i32.and (i32.ge_u (local.get $c) (i32.const 48)) (i32.le_u (local.get $c) (i32.const 57)))))
        (then (if (i32.and (i32.ge_u (local.get $c) (i32.const 65)) (i32.le_u (local.get $c) (i32.const 90)))
          (then (local.set $c (i32.add (local.get $c) (i32.const 32)))))
          (call $put (local.get $c)) (local.set $any (i32.const 1)) (local.set $dash (i32.const 0)))
        (else (if (i32.and (local.get $any) (i32.eqz (local.get $dash)))
          (then (call $put (i32.const 45)) (local.set $dash (i32.const 1))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $loop)))
    (if (local.get $dash) (then (global.set $w (i32.sub (global.get $w) (i32.const 1)))))
    (if (i32.eqz (local.get $any)) (then (call $lit (i32.const 264) (i32.const 7)))))

  (func $starts (param $p i32) (param $n i32) (param $q i32) (param $qn i32) (result i32) (local $i i32)
    (if (i32.lt_u (local.get $n) (local.get $qn)) (then (return (i32.const 0))))
    (block $done (loop $loop (br_if $done (i32.ge_u (local.get $i) (local.get $qn)))
      (if (i32.ne (i32.load8_u (i32.add (local.get $p) (local.get $i))) (i32.load8_u (i32.add (local.get $q) (local.get $i)))) (then (return (i32.const 0))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $loop))) (i32.const 1))
  (func $safeUrl (param $p i32) (param $n i32) (param $image i32) (result i32) (local $i i32) (local $c i32) (local $prefix i32)
    (local.set $prefix (if (result i32) (local.get $image)
      (then (call $starts (local.get $p) (local.get $n) (i32.const 336) (i32.const 28)))
      (else (i32.or (call $starts (local.get $p) (local.get $n) (i32.const 280) (i32.const 21))
                    (call $starts (local.get $p) (local.get $n) (i32.const 304) (i32.const 26))))))
    (if (i32.eqz (local.get $prefix)) (then (return (i32.const 0))))
    (block $done (loop $loop (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
      (local.set $c (i32.load8_u (i32.add (local.get $p) (local.get $i))))
      (if (i32.or (i32.le_u (local.get $c) (i32.const 32))
            (i32.or (i32.eq (local.get $c) (i32.const 34)) (i32.or (i32.eq (local.get $c) (i32.const 39))
            (i32.or (i32.eq (local.get $c) (i32.const 60)) (i32.or (i32.eq (local.get $c) (i32.const 62)) (i32.eq (local.get $c) (i32.const 92)))))))
        (then (return (i32.const 0))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $loop))) (i32.const 1))

  ;; AST record: type,start,len,urlStart,urlLen,allowed (six i32 fields).
  (func (export "parse_legacy") (param $input i32) (param $len i32) (param $ast i32) (param $limit i32) (result i32)
    (local $pos i32) (local $start i32) (local $end i32) (local $count i32)
    (local $type i32) (local $textStart i32) (local $textLen i32) (local $urlStart i32) (local $urlLen i32) (local $i i32) (local $close i32) (local $p i32)
    (block $allDone (loop $lines
      (br_if $allDone (i32.ge_u (local.get $pos) (local.get $len)))
      (local.set $start (local.get $pos)) (local.set $end (local.get $pos))
      (block $lineDone (loop $scan (br_if $lineDone (i32.ge_u (local.get $end) (local.get $len)))
        (br_if $lineDone (i32.eq (i32.load8_u (i32.add (local.get $input) (local.get $end))) (i32.const 10)))
        (local.set $end (i32.add (local.get $end) (i32.const 1))) (br $scan)))
      (local.set $pos (i32.add (local.get $end) (i32.const 1)))
      (if (i32.eq (local.get $start) (local.get $end)) (then (br $lines)))
      (if (i32.ge_u (local.get $count) (local.get $limit)) (then unreachable))
      (local.set $type (i32.const 3)) (local.set $textStart (local.get $start)) (local.set $textLen (i32.sub (local.get $end) (local.get $start)))
      (local.set $urlStart (i32.const 0)) (local.set $urlLen (i32.const 0))
      (if (i32.and (i32.ge_u (local.get $textLen) (i32.const 3))
            (i32.and (i32.eq (i32.load8_u (i32.add (local.get $input) (local.get $start))) (i32.const 35))
                     (i32.eq (i32.load8_u (i32.add (local.get $input) (i32.add (local.get $start) (i32.const 1)))) (i32.const 32))))
        (then (local.set $type (i32.const 1)) (local.set $textStart (i32.add (local.get $start) (i32.const 2))) (local.set $textLen (i32.sub (local.get $textLen) (i32.const 2))))
      (else (if (i32.and (i32.ge_u (local.get $textLen) (i32.const 4))
            (i32.and (i32.eq (i32.load8_u (i32.add (local.get $input) (local.get $start))) (i32.const 35))
              (i32.and (i32.eq (i32.load8_u (i32.add (local.get $input) (i32.add (local.get $start) (i32.const 1)))) (i32.const 35))
                       (i32.eq (i32.load8_u (i32.add (local.get $input) (i32.add (local.get $start) (i32.const 2)))) (i32.const 32)))))
        (then (local.set $type (i32.const 2)) (local.set $textStart (i32.add (local.get $start) (i32.const 3))) (local.set $textLen (i32.sub (local.get $textLen) (i32.const 3))))
      (else (if (i32.eq (i32.load8_u (i32.add (local.get $input) (local.get $start))) (i32.const 60))
        (then (local.set $type (i32.const 6)))
      (else
        (local.set $i (local.get $start))
        (if (i32.and (i32.ge_u (local.get $textLen) (i32.const 5)) (i32.eq (i32.load8_u (i32.add (local.get $input) (local.get $start))) (i32.const 33)))
          (then (local.set $type (i32.const 5)) (local.set $i (i32.add (local.get $start) (i32.const 1))))
          (else (if (i32.eq (i32.load8_u (i32.add (local.get $input) (local.get $start))) (i32.const 91)) (then (local.set $type (i32.const 4))))))
        (if (i32.or (i32.eq (local.get $type) (i32.const 4)) (i32.eq (local.get $type) (i32.const 5)))
          (then
            (local.set $textStart (i32.add (local.get $i) (i32.const 1))) (local.set $close (i32.const 0))
            (block $findDone (loop $find
              (br_if $findDone (i32.ge_u (local.get $i) (i32.sub (local.get $end) (i32.const 2))))
              (if (i32.and (i32.eq (i32.load8_u (i32.add (local.get $input) (local.get $i))) (i32.const 93))
                           (i32.eq (i32.load8_u (i32.add (local.get $input) (i32.add (local.get $i) (i32.const 1)))) (i32.const 40)))
                (then (local.set $close (local.get $i)) (br $findDone)))
              (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $find)))
            (if (i32.and (local.get $close) (i32.eq (i32.load8_u (i32.add (local.get $input) (i32.sub (local.get $end) (i32.const 1)))) (i32.const 41)))
              (then (local.set $textLen (i32.sub (local.get $close) (local.get $textStart)))
                    (local.set $urlStart (i32.add (local.get $close) (i32.const 2)))
                    (local.set $urlLen (i32.sub (i32.sub (local.get $end) (local.get $urlStart)) (i32.const 1))))
              (else (local.set $type (i32.const 3)) (local.set $textStart (local.get $start)) (local.set $textLen (i32.sub (local.get $end) (local.get $start)))))))))))))
      ;; Closed whole-line link/figure grammar (rechecked here so it cannot
      ;; be shadowed by a block-prefix branch).
      (if (i32.or
          (i32.eq (i32.load8_u (i32.add (local.get $input) (local.get $start))) (i32.const 91))
          (i32.eq (i32.load8_u (i32.add (local.get $input) (local.get $start))) (i32.const 33)))
        (then
          (local.set $i (local.get $start))
          (if (i32.eq (i32.load8_u (i32.add (local.get $input) (local.get $start))) (i32.const 33))
            (then (local.set $type (i32.const 5)) (local.set $i (i32.add (local.get $i) (i32.const 1))))
            (else (local.set $type (i32.const 4))))
          (local.set $textStart (i32.add (local.get $i) (i32.const 1))) (local.set $close (i32.const 0))
          (block $findAgainDone (loop $findAgain
            (br_if $findAgainDone (i32.ge_u (local.get $i) (i32.sub (local.get $end) (i32.const 2))))
            (if (i32.and (i32.eq (i32.load8_u (i32.add (local.get $input) (local.get $i))) (i32.const 93))
                         (i32.eq (i32.load8_u (i32.add (local.get $input) (i32.add (local.get $i) (i32.const 1)))) (i32.const 40)))
              (then (local.set $close (local.get $i)) (br $findAgainDone)))
            (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $findAgain)))
          (if (i32.and (local.get $close) (i32.eq (i32.load8_u (i32.add (local.get $input) (i32.sub (local.get $end) (i32.const 1)))) (i32.const 41)))
            (then (local.set $textLen (i32.sub (local.get $close) (local.get $textStart)))
                  (local.set $urlStart (i32.add (local.get $close) (i32.const 2)))
                  (local.set $urlLen (i32.sub (i32.sub (local.get $end) (local.get $urlStart)) (i32.const 1))))
            (else (local.set $type (i32.const 3)) (local.set $textStart (local.get $start)) (local.set $textLen (i32.sub (local.get $end) (local.get $start)))))))
      (local.set $p (i32.add (local.get $ast) (i32.mul (local.get $count) (i32.const 24))))
      (i32.store (local.get $p) (local.get $type)) (i32.store offset=4 (local.get $p) (local.get $textStart))
      (i32.store offset=8 (local.get $p) (local.get $textLen)) (i32.store offset=12 (local.get $p) (local.get $urlStart))
      (i32.store offset=16 (local.get $p) (local.get $urlLen)) (i32.store offset=20 (local.get $p) (i32.const 0))
      (local.set $count (i32.add (local.get $count) (i32.const 1))) (br $lines))) (local.get $count))

  (func $transform (export "transform") (param $ast i32) (param $count i32) (param $meta i32) (result i32)
    (local $i i32) (local $type i32) (local $trans i32) (local $head i32) (local $links i32)
    (block $done (loop $loop (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
      (local.set $type (i32.load (i32.add (local.get $ast) (i32.mul (local.get $i) (i32.const 24)))))
      (if (i32.or (i32.eq (local.get $type) (i32.const 1)) (i32.eq (local.get $type) (i32.const 2))) (then (local.set $head (i32.add (local.get $head) (i32.const 1))) (local.set $trans (i32.add (local.get $trans) (i32.const 1)))))
      (if (i32.or (i32.eq (local.get $type) (i32.const 4)) (i32.eq (local.get $type) (i32.const 5))) (then (local.set $links (i32.add (local.get $links) (i32.const 1))) (local.set $trans (i32.add (local.get $trans) (i32.const 1)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $loop)))
    (i32.store (local.get $meta) (local.get $trans)) (i32.store offset=8 (local.get $meta) (local.get $head))
    (i32.store offset=12 (local.get $meta) (i32.add (i32.add (local.get $count) (i32.mul (local.get $head) (i32.const 2))) (i32.add (select (i32.const 2) (i32.const 0) (local.get $head)) (local.get $links))))
    (i32.store offset=16 (local.get $meta) (local.get $links)) (local.get $trans))

  (func (export "sanitize") (param $input i32) (param $ast i32) (param $count i32) (param $meta i32) (result i32)
    (local $i i32) (local $type i32) (local $p i32) (local $ok i32) (local $checks i32) (local $reject i32) (local $start i32) (local $len i32)
    (block $done (loop $loop (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
      (local.set $p (i32.add (local.get $ast) (i32.mul (local.get $i) (i32.const 24)))) (local.set $type (i32.load (local.get $p))) (local.set $ok (i32.const 1))
      (if (i32.or (i32.eq (local.get $type) (i32.const 4)) (i32.eq (local.get $type) (i32.const 5)))
        (then (local.set $checks (i32.add (local.get $checks) (i32.const 1)))
          (local.set $ok (call $safeUrl (i32.add (local.get $input) (i32.load offset=12 (local.get $p))) (i32.load offset=16 (local.get $p)) (i32.eq (local.get $type) (i32.const 5)))))
      (else (if (i32.eq (local.get $type) (i32.const 6))
        (then (local.set $checks (i32.add (local.get $checks) (i32.const 1))) (local.set $ok (i32.const 0))
          (local.set $start (i32.load offset=4 (local.get $p))) (local.set $len (i32.load offset=8 (local.get $p)))
          ;; Attribute-free <em>...</em> or <strong>...</strong>, with no nested markup.
          (if (i32.or
            (i32.and (call $starts (i32.add (local.get $input) (local.get $start)) (local.get $len) (i32.const 400) (i32.const 4)) (i32.const 0))
            (i32.const 0)) (then (local.set $ok (i32.const 0))))))))
      ;; Raw allowlist is evaluated by exact byte shape below in render; status 2 marks raw for that check.
      (if (i32.eq (local.get $type) (i32.const 6)) (then (local.set $ok (i32.const 2))))
      (i32.store offset=20 (local.get $p) (local.get $ok))
      (if (i32.eqz (local.get $ok)) (then (local.set $reject (i32.add (local.get $reject) (i32.const 1)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $loop)))
    (i32.store offset=4 (local.get $meta) (local.get $checks)) (i32.store offset=20 (local.get $meta) (local.get $reject)) (local.get $checks))

  (func $rawAllowed (param $p i32) (param $n i32) (result i32) (local $i i32) (local $open i32) (local $close i32) (local $c i32)
    ;; em: <em> body </em>; strong: <strong> body </strong>.
    (if (i32.and (i32.ge_u (local.get $n) (i32.const 9))
      (i32.and (i32.eq (i32.load8_u (local.get $p)) (i32.const 60)) (i32.and (i32.eq (i32.load8_u offset=1 (local.get $p)) (i32.const 101)) (i32.and (i32.eq (i32.load8_u offset=2 (local.get $p)) (i32.const 109)) (i32.eq (i32.load8_u offset=3 (local.get $p)) (i32.const 62))))))
      (then (local.set $open (i32.const 4)) (local.set $close (i32.const 5))))
    (if (i32.and (i32.ge_u (local.get $n) (i32.const 17))
      (i32.and (i32.eq (i32.load8_u (local.get $p)) (i32.const 60)) (i32.and (i32.eq (i32.load8_u offset=1 (local.get $p)) (i32.const 115)) (i32.and (i32.eq (i32.load8_u offset=2 (local.get $p)) (i32.const 116)) (i32.and (i32.eq (i32.load8_u offset=3 (local.get $p)) (i32.const 114)) (i32.and (i32.eq (i32.load8_u offset=4 (local.get $p)) (i32.const 111)) (i32.and (i32.eq (i32.load8_u offset=5 (local.get $p)) (i32.const 110)) (i32.and (i32.eq (i32.load8_u offset=6 (local.get $p)) (i32.const 103)) (i32.eq (i32.load8_u offset=7 (local.get $p)) (i32.const 62))))))))))
      (then (local.set $open (i32.const 8)) (local.set $close (i32.const 9))))
    (if (i32.eqz (local.get $open)) (then (return (i32.const 0))))
    ;; Close sequence must be </ + same tag + >; compare open tag bytes.
    (if (i32.ne (i32.load8_u (i32.add (local.get $p) (i32.sub (local.get $n) (local.get $close)))) (i32.const 60)) (then (return (i32.const 0))))
    (if (i32.ne (i32.load8_u (i32.add (local.get $p) (i32.add (i32.sub (local.get $n) (local.get $close)) (i32.const 1)))) (i32.const 47)) (then (return (i32.const 0))))
    (local.set $i (i32.const 1))
    (block $tagDone (loop $tag (br_if $tagDone (i32.ge_u (local.get $i) (i32.sub (local.get $open) (i32.const 1))))
      (if (i32.ne (i32.load8_u (i32.add (local.get $p) (local.get $i))) (i32.load8_u (i32.add (local.get $p) (i32.add (i32.sub (local.get $n) (local.get $close)) (i32.add (local.get $i) (i32.const 1)))))) (then (return (i32.const 0))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $tag)))
    (if (i32.ne (i32.load8_u (i32.add (local.get $p) (i32.sub (local.get $n) (i32.const 1)))) (i32.const 62)) (then (return (i32.const 0))))
    (local.set $i (local.get $open))
    (block $bodyDone (loop $body (br_if $bodyDone (i32.ge_u (local.get $i) (i32.sub (local.get $n) (local.get $close))))
      (local.set $c (i32.load8_u (i32.add (local.get $p) (local.get $i))))
      (if (i32.or (i32.eq (local.get $c) (i32.const 60)) (i32.eq (local.get $c) (i32.const 62))) (then (return (i32.const 0))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $body))) (i32.const 1))

  (func (export "render") (param $input i32) (param $ast i32) (param $count i32) (param $out i32) (param $outcap i32) (param $meta i32) (result i32)
    (local $i i32) (local $p i32) (local $type i32) (local $start i32) (local $len i32) (local $url i32) (local $urlLen i32) (local $reject i32)
    (global.set $w (local.get $out)) (global.set $cap (i32.add (local.get $out) (local.get $outcap)))
    (if (i32.load offset=8 (local.get $meta)) (then
      (call $lit (i32.const 0) (i32.const 40))
      (block $tocDone (loop $toc (br_if $tocDone (i32.ge_u (local.get $i) (local.get $count)))
        (local.set $p (i32.add (local.get $ast) (i32.mul (local.get $i) (i32.const 24)))) (local.set $type (i32.load (local.get $p)))
        (if (i32.or (i32.eq (local.get $type) (i32.const 1)) (i32.eq (local.get $type) (i32.const 2))) (then
          (local.set $start (i32.add (local.get $input) (i32.load offset=4 (local.get $p)))) (local.set $len (i32.load offset=8 (local.get $p)))
          (call $lit (i32.const 64) (i32.const 14)) (call $slug (local.get $start) (local.get $len)) (call $lit (i32.const 80) (i32.const 2))
          (call $escaped (local.get $start) (local.get $len)) (call $lit (i32.const 84) (i32.const 9))))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $toc))) (call $lit (i32.const 48) (i32.const 11))))
    (local.set $i (i32.const 0))
    (block $done (loop $loop (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
      (local.set $p (i32.add (local.get $ast) (i32.mul (local.get $i) (i32.const 24)))) (local.set $type (i32.load (local.get $p)))
      (local.set $start (i32.add (local.get $input) (i32.load offset=4 (local.get $p)))) (local.set $len (i32.load offset=8 (local.get $p)))
      (local.set $url (i32.add (local.get $input) (i32.load offset=12 (local.get $p)))) (local.set $urlLen (i32.load offset=16 (local.get $p)))
      (if (i32.eq (local.get $type) (i32.const 1)) (then (call $lit (i32.const 96) (i32.const 8)) (call $slug (local.get $start) (local.get $len)) (call $lit (i32.const 80) (i32.const 2)) (call $escaped (local.get $start) (local.get $len)) (call $lit (i32.const 120) (i32.const 5)))
      (else (if (i32.eq (local.get $type) (i32.const 2)) (then (call $lit (i32.const 108) (i32.const 8)) (call $slug (local.get $start) (local.get $len)) (call $lit (i32.const 80) (i32.const 2)) (call $escaped (local.get $start) (local.get $len)) (call $lit (i32.const 128) (i32.const 5)))
      (else (if (i32.eq (local.get $type) (i32.const 3)) (then (call $lit (i32.const 136) (i32.const 3)) (call $escaped (local.get $start) (local.get $len)) (call $lit (i32.const 144) (i32.const 4)))
      (else (if (i32.eq (local.get $type) (i32.const 4)) (then (if (i32.load offset=20 (local.get $p)) (then (call $lit (i32.const 152) (i32.const 12)) (call $escaped (local.get $url) (local.get $urlLen)) (call $lit (i32.const 80) (i32.const 2)) (call $escaped (local.get $start) (local.get $len)) (call $lit (i32.const 168) (i32.const 8)))))
      (else (if (i32.eq (local.get $type) (i32.const 5)) (then (if (i32.load offset=20 (local.get $p)) (then (call $lit (i32.const 180) (i32.const 18)) (call $escaped (local.get $url) (local.get $urlLen)) (call $lit (i32.const 200) (i32.const 7)) (call $escaped (local.get $start) (local.get $len)) (call $lit (i32.const 208) (i32.const 11)))))
      (else (if (call $rawAllowed (local.get $start) (local.get $len)) (then (call $lit (local.get $start) (local.get $len))) (else (local.set $reject (i32.add (local.get $reject) (i32.const 1)))))))))))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $loop)))
    ;; sanitize could not decide raw bodies without this final exact check.
    (i32.store offset=20 (local.get $meta) (i32.add (i32.load offset=20 (local.get $meta)) (local.get $reject)))
    (i32.sub (global.get $w) (local.get $out)))

  ;; Transform stage also canonicalizes figure records from their raw line
  ;; bytes before counting transformed nodes.
  (func (export "transform_with_input") (param $input i32) (param $ast i32) (param $count i32) (param $meta i32) (result i32)
    (local $i i32) (local $p i32) (local $start i32) (local $len i32) (local $j i32) (local $close i32)
    (block $done (loop $loop
      (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
      (local.set $p (i32.add (local.get $ast) (i32.mul (local.get $i) (i32.const 24))))
      (local.set $start (i32.load offset=4 (local.get $p))) (local.set $len (i32.load offset=8 (local.get $p)))
      (if (i32.and (i32.ge_u (local.get $len) (i32.const 5))
          (i32.eq (i32.load8_u (i32.add (local.get $input) (local.get $start))) (i32.const 33)))
        (then
          (local.set $j (i32.add (local.get $start) (i32.const 1))) (local.set $close (i32.const 0))
          (block $found (loop $find
            (br_if $found (i32.ge_u (local.get $j) (i32.sub (i32.add (local.get $start) (local.get $len)) (i32.const 2))))
            (if (i32.and (i32.eq (i32.load8_u (i32.add (local.get $input) (local.get $j))) (i32.const 93))
                         (i32.eq (i32.load8_u (i32.add (local.get $input) (i32.add (local.get $j) (i32.const 1)))) (i32.const 40)))
              (then (local.set $close (local.get $j)) (br $found)))
            (local.set $j (i32.add (local.get $j) (i32.const 1))) (br $find)))
          (if (i32.and (local.get $close)
                (i32.eq (i32.load8_u (i32.add (local.get $input) (i32.sub (i32.add (local.get $start) (local.get $len)) (i32.const 1)))) (i32.const 41)))
            (then
              (i32.store (local.get $p) (i32.const 5))
              (i32.store offset=4 (local.get $p) (i32.add (local.get $start) (i32.const 2)))
              (i32.store offset=8 (local.get $p) (i32.sub (local.get $close) (i32.add (local.get $start) (i32.const 2))))
              (i32.store offset=12 (local.get $p) (i32.add (local.get $close) (i32.const 2)))
              (i32.store offset=16 (local.get $p) (i32.sub (i32.sub (i32.add (local.get $start) (local.get $len)) (i32.add (local.get $close) (i32.const 2))) (i32.const 1)))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $loop)))
    (call $transform (local.get $ast) (local.get $count) (local.get $meta)))

  ;; Straight-line closed grammar parser used by the controlled target.
  (func (export "parse") (param $input i32) (param $len i32) (param $ast i32) (param $limit i32) (result i32)
    (local $pos i32) (local $start i32) (local $end i32) (local $count i32) (local $first i32)
    (local $type i32) (local $ts i32) (local $tn i32) (local $us i32) (local $un i32)
    (local $i i32) (local $close i32) (local $p i32)
    (block $done (loop $lines
      (br_if $done (i32.ge_u (local.get $pos) (local.get $len)))
      (local.set $start (local.get $pos)) (local.set $end (local.get $pos))
      (block $eol (loop $scan
        (br_if $eol (i32.ge_u (local.get $end) (local.get $len)))
        (br_if $eol (i32.eq (i32.load8_u (i32.add (local.get $input) (local.get $end))) (i32.const 10)))
        (local.set $end (i32.add (local.get $end) (i32.const 1))) (br $scan)))
      (local.set $pos (i32.add (local.get $end) (i32.const 1)))
      (if (i32.eq (local.get $start) (local.get $end)) (then (br $lines)))
      (if (i32.ge_u (local.get $count) (local.get $limit)) (then unreachable))
      (local.set $first (i32.load8_u (i32.add (local.get $input) (local.get $start))))
      (local.set $type (i32.const 3)) (local.set $ts (local.get $start))
      (local.set $tn (i32.sub (local.get $end) (local.get $start))) (local.set $us (i32.const 0)) (local.set $un (i32.const 0))
      (if (i32.eq (local.get $first) (i32.const 35))
        (then
          (if (i32.and (i32.ge_u (local.get $tn) (i32.const 3))
                (i32.eq (i32.load8_u (i32.add (local.get $input) (i32.add (local.get $start) (i32.const 1)))) (i32.const 32)))
            (then (local.set $type (i32.const 1)) (local.set $ts (i32.add (local.get $start) (i32.const 2))) (local.set $tn (i32.sub (local.get $tn) (i32.const 2))))
          (else (if (i32.and (i32.ge_u (local.get $tn) (i32.const 4))
              (i32.and (i32.eq (i32.load8_u (i32.add (local.get $input) (i32.add (local.get $start) (i32.const 1)))) (i32.const 35))
                       (i32.eq (i32.load8_u (i32.add (local.get $input) (i32.add (local.get $start) (i32.const 2)))) (i32.const 32))))
            (then (local.set $type (i32.const 2)) (local.set $ts (i32.add (local.get $start) (i32.const 3))) (local.set $tn (i32.sub (local.get $tn) (i32.const 3))))))))
      (else (if (i32.eq (local.get $first) (i32.const 60))
        (then (local.set $type (i32.const 6)))
      (else (if (i32.or (i32.eq (local.get $first) (i32.const 91)) (i32.eq (local.get $first) (i32.const 33)))
        (then
          (local.set $i (local.get $start))
          (if (i32.eq (local.get $first) (i32.const 33))
            (then (local.set $type (i32.const 5)) (local.set $i (i32.add (local.get $i) (i32.const 1))))
            (else (local.set $type (i32.const 4))))
          (local.set $ts (i32.add (local.get $i) (i32.const 1))) (local.set $close (i32.const 0))
          (block $found (loop $find
            (br_if $found (i32.ge_u (local.get $i) (i32.sub (local.get $end) (i32.const 2))))
            (if (i32.and (i32.eq (i32.load8_u (i32.add (local.get $input) (local.get $i))) (i32.const 93))
                         (i32.eq (i32.load8_u (i32.add (local.get $input) (i32.add (local.get $i) (i32.const 1)))) (i32.const 40)))
              (then (local.set $close (local.get $i)) (br $found)))
            (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $find)))
          (if (i32.and (local.get $close) (i32.eq (i32.load8_u (i32.add (local.get $input) (i32.sub (local.get $end) (i32.const 1)))) (i32.const 41)))
            (then (local.set $tn (i32.sub (local.get $close) (local.get $ts)))
                  (local.set $us (i32.add (local.get $close) (i32.const 2)))
                  (local.set $un (i32.sub (i32.sub (local.get $end) (local.get $us)) (i32.const 1))))
            (else (local.set $type (i32.const 3)) (local.set $ts (local.get $start)) (local.set $tn (i32.sub (local.get $end) (local.get $start)))))
        ))))))
      (local.set $p (i32.add (local.get $ast) (i32.mul (local.get $count) (i32.const 24))))
      (i32.store (local.get $p) (local.get $type)) (i32.store offset=4 (local.get $p) (local.get $ts))
      (i32.store offset=8 (local.get $p) (local.get $tn)) (i32.store offset=12 (local.get $p) (local.get $us))
      (i32.store offset=16 (local.get $p) (local.get $un)) (i32.store offset=20 (local.get $p) (i32.const 0))
      (local.set $count (i32.add (local.get $count) (i32.const 1))) (br $lines)))
    (local.get $count))
)

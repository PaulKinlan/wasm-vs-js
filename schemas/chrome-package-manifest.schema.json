{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "binaryRelativePath", "binarySha256", "manifestSha256", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "binaryRelativePath": { "type": "string", "pattern": "^[^/].+$" },
    "binarySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "manifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    }
  }
}

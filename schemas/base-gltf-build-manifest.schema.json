{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PaulKinlan/wasm-vs-js/schemas/base-gltf-build-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workloadId",
    "sourceCommit",
    "toolchain",
    "commands",
    "sources",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workloadId": { "const": "graphics.gltf-viewer.v1" },
    "sourceCommit": { "$ref": "#/$defs/commit" },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deno", "clang", "lld", "draco", "imageMagick"],
      "properties": {
        "deno": { "type": "string", "minLength": 1 },
        "clang": { "const": "22.1.8" },
        "lld": { "const": "22.1.8" },
        "draco": { "const": "1.5.7" },
        "imageMagick": { "const": "7.1.2-27" }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1 }
    },
    "sources": { "type": "array", "minItems": 17, "items": { "$ref": "#/$defs/source" } },
    "artifacts": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/file" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "immutableUrl"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "immutableUrl": {
          "type": "string",
          "pattern": "^https://github\\.com/PaulKinlan/wasm-vs-js/blob/[a-f0-9]{40}/"
        }
      }
    }
  }
}

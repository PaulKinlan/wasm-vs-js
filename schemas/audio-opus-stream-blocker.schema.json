{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wasm-vs-js.paulkinlan-ea.deno.net/schemas/audio-opus-stream-blocker.schema.json",
  "title": "Frozen-v1 Opus workload blocker evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workloadId",
    "catalogBinding",
    "status",
    "coverageClaim",
    "interactiveDemo",
    "decision",
    "fixtureRecipe",
    "referenceImplementation",
    "controlledJavaScriptAudit",
    "requiredContract",
    "unavailableEvidence",
    "reproduction"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workloadId": { "const": "audio.opus-stream.v1" },
    "catalogBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogId", "sha256", "immutability"],
      "properties": {
        "catalogId": { "const": "workload-catalog-v1" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "immutability": { "const": "byte-for-byte" }
      }
    },
    "status": { "const": "blocked" },
    "coverageClaim": { "const": false },
    "interactiveDemo": { "type": "null" },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "summary", "observedAt", "unblockConditions"],
      "properties": {
        "code": { "const": "independent-controlled-javascript-decoder-unavailable" },
        "summary": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" },
        "unblockConditions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "fixtureRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "redistribution",
        "archive",
        "archiveLayout",
        "officialInvocation",
        "comparisonPolicy"
      ],
      "properties": {
        "redistribution": { "const": "recipe-only" },
        "archive": { "$ref": "#/$defs/download" },
        "archiveLayout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entryCountIncludingDirectory", "bitstreams", "referencePcmFiles"],
          "properties": {
            "entryCountIncludingDirectory": { "const": 37 },
            "bitstreams": { "const": 12 },
            "referencePcmFiles": { "const": 24 }
          }
        },
        "officialInvocation": { "const": "./tests/run_vectors.sh ./ opus_newvectors 48000" },
        "comparisonPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sampleRate", "channelRuns", "vectorIds", "acceptance"],
          "properties": {
            "sampleRate": { "const": 48000 },
            "channelRuns": {
              "type": "array",
              "prefixItems": [{ "const": 1 }, { "const": 2 }],
              "items": false
            },
            "vectorIds": {
              "type": "array",
              "minItems": 12,
              "maxItems": 12,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[0-9]{2}$" }
            },
            "acceptance": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "referenceImplementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "source", "licenseSpdx", "role", "runnerPath"],
      "properties": {
        "name": { "const": "libopus" },
        "version": { "const": "1.5.2" },
        "source": { "$ref": "#/$defs/download" },
        "licenseSpdx": { "const": "BSD-3-Clause" },
        "role": { "const": "official-reference-and-material-wasm-candidate" },
        "runnerPath": { "const": "tests/run_vectors.sh" }
      }
    },
    "controlledJavaScriptAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredIndependence", "searchDisposition", "candidates"],
      "properties": {
        "requiredIndependence": {
          "const": "not-libopus-derived-and-not-wasm-native-or-webcodecs-facade"
        },
        "searchDisposition": { "const": "no-qualifying-candidate" },
        "candidates": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "package",
              "version",
              "download",
              "licenseSpdx",
              "observedMarkers",
              "disposition"
            ],
            "properties": {
              "package": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "download": { "$ref": "#/$defs/download" },
              "licenseSpdx": { "type": "string", "minLength": 1 },
              "observedMarkers": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "disposition": { "const": "rejected-same-libopus-lineage-or-wasm-facade" }
            }
          }
        }
      }
    },
    "requiredContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixedWork", "decodeSemantics", "outputs", "counters", "lifecycle"],
      "properties": {
        "fixedWork": { "type": "string", "minLength": 1 },
        "decodeSemantics": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "counters": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "lifecycle": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "unavailableEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "javascriptSource",
        "wasmSource",
        "wasmArtifact",
        "resultRecords",
        "browserEvidence",
        "performanceEvidence"
      ],
      "properties": {
        "javascriptSource": { "const": "unavailable" },
        "wasmSource": { "const": "unavailable" },
        "wasmArtifact": { "const": "unavailable" },
        "resultRecords": { "const": "unavailable" },
        "browserEvidence": { "const": "unavailable" },
        "performanceEvidence": { "const": "unavailable" }
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["denoVersion", "command", "networkHosts", "committedFixtureBytes"],
      "properties": {
        "denoVersion": { "const": "2.9.0" },
        "command": { "type": "string", "minLength": 1 },
        "networkHosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "committedFixtureBytes": { "const": false }
      }
    }
  },
  "$defs": {
    "download": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "bytes"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}

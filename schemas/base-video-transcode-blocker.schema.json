{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wasm-vs-js.paulkinlan.net/schemas/base-video-transcode-blocker.schema.json",
  "title": "Frozen video transcode workload implementation blocker",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogWorkloadId",
    "catalogSha256",
    "status",
    "implementationCoverage",
    "reasonCode",
    "requirement",
    "controlledJavaScriptCandidates",
    "materialWasmCandidate",
    "reproduction",
    "unresolvedRequirements",
    "nextAction"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogWorkloadId": { "const": "media.video-transcode.v1" },
    "catalogSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "const": "blocked" },
    "implementationCoverage": { "const": false },
    "reasonCode": { "const": "controlled-javascript-vp9-encoder-unavailable" },
    "requirement": { "type": "string", "minLength": 1 },
    "controlledJavaScriptCandidates": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "licenseSpdx",
          "source",
          "packageTarballSha256",
          "disposition",
          "evidence"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "licenseSpdx": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "format": "uri" },
          "packageTarballSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "disposition": { "enum": ["host-vp8", "wasm-backed", "host-webcodecs", "empty-package"] },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "materialWasmCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "licenseSpdx", "source", "nativeProbeSha256", "disposition"],
      "properties": {
        "name": { "const": "libvpx" },
        "version": { "type": "string", "minLength": 1 },
        "licenseSpdx": { "const": "BSD-3-Clause" },
        "source": { "type": "string", "format": "uri" },
        "nativeProbeSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "disposition": { "const": "credible-unbuilt-wasm-source" }
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "denoVersion", "npmVersion", "libvpxVersion", "candidateChecks"],
      "properties": {
        "script": { "type": "string", "minLength": 1 },
        "denoVersion": { "const": "2.9.0" },
        "npmVersion": { "type": "string", "minLength": 1 },
        "libvpxVersion": { "type": "string", "minLength": 1 },
        "candidateChecks": { "type": "integer", "minimum": 5 }
      }
    },
    "unresolvedRequirements": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "nextAction": { "type": "string", "minLength": 1 }
  }
}

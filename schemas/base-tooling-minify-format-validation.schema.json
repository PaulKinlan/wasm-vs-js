{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "baseWorkloadId",
    "target",
    "status",
    "authoritativePerformanceEvidence",
    "catalogV1Sha256",
    "fixtureManifestSha256",
    "artifactSha256",
    "cells"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordId": { "type": "string", "minLength": 1 },
    "baseWorkloadId": { "const": "tooling.minify-format.v1" },
    "target": { "enum": ["javascript-controlled", "linear-wasm-controlled"] },
    "status": { "const": "validation-package" },
    "authoritativePerformanceEvidence": { "const": false },
    "catalogV1Sha256": {
      "const": "6665664f984683e5b7d3fdc8c1602198124844704c224a526d48be2f02edf9d4"
    },
    "fixtureManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "cells": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/cell" } }
  },
  "$defs": {
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "operation",
        "inputBytes",
        "outputBytes",
        "outputSha256",
        "counters"
      ],
      "properties": {
        "language": { "enum": ["javascript", "css", "html"] },
        "operation": { "enum": ["minify", "format"] },
        "inputBytes": { "type": "integer", "minimum": 1 },
        "outputBytes": { "type": "integer", "minimum": 1 },
        "outputSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "counters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inputBytes",
            "outputBytes",
            "tokens",
            "nodes",
            "transforms",
            "allocations",
            "boundaryCrossings"
          ],
          "properties": {
            "inputBytes": { "type": "integer", "minimum": 1 },
            "outputBytes": { "type": "integer", "minimum": 1 },
            "tokens": { "type": "integer", "minimum": 1 },
            "nodes": { "type": "integer", "minimum": 1 },
            "transforms": { "type": "integer", "minimum": 1 },
            "allocations": { "type": "integer", "minimum": 0 },
            "boundaryCrossings": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}

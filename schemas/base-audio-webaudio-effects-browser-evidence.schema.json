        "bytes": { "const": 10477 },
        "sha256": { "const": "61d09e66febd9fa65916472219198306aa43e4d7a9095c8d94aa1daa6f6b4174" },
        "base64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$",
          "minLength": 13972,
          "maxLength": 13972
        }
      }
    },

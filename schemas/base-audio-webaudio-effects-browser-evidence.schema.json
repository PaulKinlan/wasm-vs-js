{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wasm-vs-js.ai-focus.dev/schemas/base-audio-webaudio-effects-browser-evidence.v1.json",
  "title": "audio.webaudio-effects.v1 authoritative owned Chrome browser evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workload",
    "evidenceId",
    "collectedAt",
    "acceptedStaticCommit",
    "source",
    "collector",
    "browser",
    "server",
    "contract",
    "scenarios",
    "cleanup"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workload": { "const": "audio.webaudio-effects.v1" },
    "evidenceId": {
      "type": "string",
      "pattern": "^audio-webaudio-effects-browser-[a-f0-9]{12}$"
    },
    "collectedAt": { "type": "string", "format": "date-time" },
    "acceptedStaticCommit": {
      "const": "1f48dc3adf1f42f698bbe50c5787a193905af72a"
    },
    "source": { "$ref": "#/$defs/source" },
    "collector": { "$ref": "#/$defs/collector" },
    "browser": { "$ref": "#/$defs/browser" },
    "server": { "$ref": "#/$defs/server" },
    "contract": { "$ref": "#/$defs/contract" },
    "scenarios": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/completeScenario" },
            { "$ref": "#/$defs/javascriptComplete" }
          ]
        },
        { "allOf": [{ "$ref": "#/$defs/completeScenario" }, { "$ref": "#/$defs/wasmComplete" }] },
        { "allOf": [{ "$ref": "#/$defs/lifecycleScenario" }, { "$ref": "#/$defs/wrongToken" }] },
        { "allOf": [{ "$ref": "#/$defs/lifecycleScenario" }, { "$ref": "#/$defs/staleRestart" }] },
        { "allOf": [{ "$ref": "#/$defs/lifecycleScenario" }, { "$ref": "#/$defs/restart" }] },
        { "allOf": [{ "$ref": "#/$defs/lifecycleScenario" }, { "$ref": "#/$defs/cancel" }] },
        { "allOf": [{ "$ref": "#/$defs/lifecycleScenario" }, { "$ref": "#/$defs/timeout" }] },
        { "allOf": [{ "$ref": "#/$defs/lifecycleScenario" }, { "$ref": "#/$defs/pagehide" }] }
      ],
      "items": false
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browserProcesses", "cgroup", "profile", "server"],
      "properties": {
        "browserProcesses": { "$ref": "#/$defs/successCleanup" },
        "cgroup": { "$ref": "#/$defs/successCleanup" },
        "profile": { "$ref": "#/$defs/successCleanup" },
        "server": { "$ref": "#/$defs/successCleanup" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitIdentity": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "cdpIdentity": { "type": "string", "minLength": 1 },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "cleanStatus"],
      "properties": {
        "commit": { "$ref": "#/$defs/gitIdentity" },
        "tree": { "$ref": "#/$defs/gitIdentity" },
        "cleanStatus": { "const": "clean" }
      }
    },
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "sourcePath", "bytes", "sha256", "gitBlob"],
      "properties": {
        "route": { "type": "string", "pattern": "^/" },
        "sourcePath": { "type": "string", "pattern": "^(public|benchmarks)/" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "gitBlob": { "$ref": "#/$defs/gitIdentity" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "unchanged", "root", "assets"],
      "properties": {
        "start": { "$ref": "#/$defs/sourceIdentity" },
        "end": { "$ref": "#/$defs/sourceIdentity" },
        "unchanged": { "const": true },
        "root": { "type": "string", "pattern": "^/" },
        "assets": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/fileRecord" },
                {
                  "properties": {
                    "route": { "const": "/benchmarks/base/audio-webaudio-effects-v1/" },
                    "sourcePath": {
                      "const": "public/benchmarks/base/audio-webaudio-effects-v1/index.html"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/fileRecord" },
                {
                  "properties": {
                    "route": { "const": "/styles.css" },
                    "sourcePath": { "const": "public/styles.css" }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/fileRecord" },
                {
                  "properties": {
                    "route": { "const": "/base-audio-effects-demo.js" },
                    "sourcePath": { "const": "public/base-audio-effects-demo.js" }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/fileRecord" },
                {
                  "properties": {
                    "route": { "const": "/base-audio-effects-worker.js" },
                    "sourcePath": { "const": "public/base-audio-effects-worker.js" }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/fileRecord" },
                {
                  "properties": {
                    "route": { "const": "/benchmarks/base/audio-webaudio-effects/workload.js" },
                    "sourcePath": { "const": "benchmarks/base/audio-webaudio-effects/workload.js" }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/fileRecord" },
                {
                  "properties": {
                    "route": {
                      "const": "/artifacts/base-audio-webaudio-effects-v1/build-manifest.json"
                    },
                    "sourcePath": {
                      "const": "public/artifacts/base-audio-webaudio-effects-v1/build-manifest.json"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/fileRecord" },
                {
                  "properties": {
                    "route": {
                      "const": "/artifacts/base-audio-webaudio-effects-v1/output-manifest.json"
                    },
                    "sourcePath": {
                      "const": "public/artifacts/base-audio-webaudio-effects-v1/output-manifest.json"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/fileRecord" },
                {
                  "properties": {
                    "route": {
                      "const": "/artifacts/base-audio-webaudio-effects-v1/audio-webaudio-effects.wasm"
                    },
                    "sourcePath": {
                      "const": "public/artifacts/base-audio-webaudio-effects-v1/audio-webaudio-effects.wasm"
                    }
                  }
                }
              ]
            }
          ],
          "items": false
        }
      }
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "bytes", "sha256", "command", "denoVersion"],
      "properties": {
        "script": { "const": "scripts/collect-base-audio-webaudio-effects-browser-evidence.ts" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "command": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1 }
        },
        "denoVersion": { "type": "string", "minLength": 1 }
      }
    },
    "processIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "parentPid", "startTimeTicks", "executable"],
      "properties": {
        "pid": { "type": "integer", "minimum": 2 },
        "parentPid": { "type": "integer", "minimum": 0 },
        "startTimeTicks": { "type": "string", "pattern": "^[0-9]+$" },
        "executable": { "type": "string", "pattern": "^/" }
      }
    },
    "memberSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "pids"],
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "pids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 2 }
        }
      }
    },
    "cgroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "controlGroup",
        "path",
        "device",
        "inode",
        "invocationId",
        "mainPid",
        "memberSnapshots",
        "listenerAssertions"
      ],
      "properties": {
        "unit": { "type": "string", "pattern": "^wasm-audio-effects-[a-f0-9]{16}\\.service$" },
        "controlGroup": { "type": "string", "pattern": "^/" },
        "path": { "type": "string", "pattern": "^/sys/fs/cgroup/" },
        "device": { "type": "integer", "minimum": 1 },
        "inode": { "type": "integer", "minimum": 1 },
        "invocationId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "mainPid": { "type": "integer", "minimum": 2 },
        "memberSnapshots": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/memberSnapshot" }
        },
        "listenerAssertions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/listenerOwnershipProof" }
        }
      }
    },
    "listenerOwnershipProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "port", "socketInode", "ownerPid", "ownerFd", "cgroupPids"],
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "socketInode": { "type": "string", "pattern": "^[0-9]+$" },
        "ownerPid": { "type": "integer", "minimum": 2 },
        "ownerFd": { "type": "string", "pattern": "^[0-9]+$" },
        "cgroupPids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 2 }
        }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "revision",
        "userAgent",
        "jsVersion",
        "executable",
        "executableBytes",
        "executableSha256",
        "executableDevice",
        "executableInode",
        "launchArguments",
        "effectiveArguments",
        "headless",
        "protocol",
        "profile",
        "cgroup",
        "processes"
      ],
      "properties": {
        "product": { "const": "Chrome/150.0.7871.24" },
        "revision": { "type": "string", "minLength": 1 },
        "userAgent": { "type": "string", "minLength": 1 },
        "jsVersion": { "type": "string", "minLength": 1 },
        "executable": {
          "type": "string",
          "pattern": "/chrome/linux-150\\.0\\.7871\\.24/chrome-linux64/chrome$"
        },
        "executableBytes": { "const": 281758968 },
        "executableSha256": {
          "const": "dea3ab8fba923b718920ef9d62570824f2dc0ab0c72d66d53f91b41de6570355"
        },
        "executableDevice": { "type": "integer", "minimum": 1 },
        "executableInode": { "type": "integer", "minimum": 1 },
        "launchArguments": {
          "type": "array",
          "minItems": 20,
          "maxItems": 20,
          "prefixItems": [
            {
              "type": "string",
              "pattern": "^--user-data-dir=/tmp/wasm-vs-js-owned-profiles/audio-effects-[a-f0-9-]+/launch$"
            },
            { "const": "--remote-debugging-port=0" },
            { "const": "--remote-debugging-address=127.0.0.1" },
            { "const": "--headless=new" },
            { "const": "--no-sandbox" },
            { "const": "--disable-gpu" },
            { "const": "--disable-background-networking" },
            { "const": "--disable-component-update" },
            { "const": "--disable-default-apps" },
            { "const": "--disable-extensions" },
            { "const": "--disable-sync" },
            { "const": "--disable-crash-reporter" },
            { "const": "--disable-breakpad" },
            { "const": "--metrics-recording-only" },
            { "const": "--no-first-run" },
            { "const": "--no-default-browser-check" },
            { "const": "--hide-scrollbars" },
            { "const": "--enable-automation" },
            { "const": "--window-size=1440,1200" },
            { "const": "about:blank" }
          ],
          "items": false
        },
        "effectiveArguments": {
          "type": "array",
          "minItems": 20,
          "items": { "type": "string", "minLength": 1 }
        },
        "headless": { "const": true },
        "protocol": { "const": "Chrome DevTools Protocol" },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "device", "inode", "mode", "createdEmpty"],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/tmp/wasm-vs-js-owned-profiles/audio-effects-[a-f0-9-]+/launch$"
            },
            "device": { "type": "integer", "minimum": 1 },
            "inode": { "type": "integer", "minimum": 1 },
            "mode": { "const": 448 },
            "createdEmpty": { "const": true }
          }
        },
        "cgroup": { "$ref": "#/$defs/cgroup" },
        "processes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/processIdentity" }
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "mode", "launcher"],
      "properties": {
        "origin": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]+$" },
        "mode": { "const": "public" },
        "launcher": { "$ref": "#/$defs/processIdentity" }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "absoluteTolerance",
        "relativeTolerance",
        "maxAbsolute",
        "maxRelative",
        "violations",
        "nonFinite"
      ],
      "properties": {
        "kind": { "const": "full-output-f64-tolerance" },
        "absoluteTolerance": { "const": 0.00002 },
        "relativeTolerance": { "const": 0.0002 },
        "maxAbsolute": { "const": 0.0000018638636976597844 },
        "maxRelative": { "const": 0.24027635719300827 },
        "violations": { "const": 0 },
        "nonFinite": { "const": 0 }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seconds",
        "channels",
        "frames",
        "outputFrames",
        "outputBytes",
        "outputSha256",
        "targets",
        "blocksPerChannel",
        "blockInvocations",
        "stateCarryBoundaries",
        "oracle",
        "performanceClaim"
      ],
      "properties": {
        "seconds": { "const": 60 },
        "channels": { "const": 2 },
        "frames": { "const": 2880000 },
        "outputFrames": { "const": 2880015 },
        "outputBytes": { "const": 23040120 },
        "outputSha256": {
          "const": "fba0623a3af7679b1e95b79c7f454c38e1ac2123de5ebf3a7a86bc43bff16550"
        },
        "targets": { "const": ["javascript", "wasm-linear"] },
        "blocksPerChannel": { "const": 22500 },
        "blockInvocations": { "const": 45000 },
        "stateCarryBoundaries": { "const": 44998 },
        "oracle": { "$ref": "#/$defs/oracle" },
        "performanceClaim": { "const": false }
      }
    },
    "targetIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "sessionId"],
      "properties": {
        "targetId": { "$ref": "#/$defs/cdpIdentity" },
        "sessionId": { "$ref": "#/$defs/cdpIdentity" }
      }
    },
    "consoleEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "type", "arguments", "timestamp"],
      "properties": {
        "context": { "enum": ["page", "worker"] },
        "type": { "type": "string", "minLength": 1 },
        "arguments": { "type": "array", "items": { "type": "string" } },
        "timestamp": { "type": "number", "minimum": 0 }
      }
    },
    "exceptionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "text", "lineNumber", "columnNumber"],
      "properties": {
        "context": { "enum": ["page", "worker"] },
        "text": { "type": "string", "minLength": 1 },
        "lineNumber": { "type": "integer", "minimum": 0 },
        "columnNumber": { "type": "integer", "minimum": 0 }
      }
    },
    "supportedBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "bytes", "sha256", "base64", "sourcePath", "gitBlob"],
      "properties": {
        "status": { "const": "supported" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "base64": { "type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$" },
        "sourcePath": { "type": "string", "pattern": "^(public|benchmarks)/" },
        "gitBlob": { "$ref": "#/$defs/gitIdentity" }
      }
    },
    "unavailableBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "const": "unavailable" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "networkEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "sessionId",
        "requestId",
        "url",
        "method",
        "resourceType",
        "status",
        "mimeType",
        "fromDiskCache",
        "fromServiceWorker",
        "failed",
        "responseBody"
      ],
      "properties": {
        "context": { "enum": ["page", "worker"] },
        "sessionId": { "$ref": "#/$defs/cdpIdentity" },
        "requestId": { "$ref": "#/$defs/cdpIdentity" },
        "url": {
          "type": "string",
          "pattern": "^(http://127\\.0\\.0\\.1:[0-9]+/|blob:http://127\\.0\\.0\\.1:[0-9]+/)"
        },
        "method": { "const": "GET" },
        "resourceType": { "type": "string", "minLength": 1 },
        "status": { "const": 200 },
        "mimeType": { "type": "string" },
        "fromDiskCache": { "const": false },
        "fromServiceWorker": { "const": false },
        "failed": { "const": false },
        "responseBody": {
          "oneOf": [
            { "$ref": "#/$defs/supportedBody" },
            { "$ref": "#/$defs/unavailableBody" }
          ]
        }
      }
    },
    "executedScript": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "sessionId",
        "route",
        "sourcePath",
        "bytes",
        "sha256",
        "base64",
        "gitBlob"
      ],
      "properties": {
        "context": { "enum": ["page", "worker"] },
        "sessionId": { "$ref": "#/$defs/cdpIdentity" },
        "route": { "type": "string", "pattern": "\\.js$" },
        "sourcePath": { "type": "string", "pattern": "^(public|benchmarks)/.*\\.js$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "base64": { "type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$" },
        "gitBlob": { "$ref": "#/$defs/gitIdentity" }
      }
    },
    "axRelationshipTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backendDOMNodeId", "text"],
      "properties": {
        "backendDOMNodeId": { "type": "integer", "minimum": 1 },
        "text": { "type": "string" }
      }
    },
    "axRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "targets"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/axRelationshipTarget" }
        }
      }
    },
    "axControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "name", "relationships"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "relationships": {
          "type": "array",
          "items": { "$ref": "#/$defs/axRelationship" }
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bodyText", "statusText", "resultText", "axControls"],
      "properties": {
        "bodyText": { "type": "string", "minLength": 1 },
        "statusText": { "type": "string", "minLength": 1 },
        "resultText": { "type": "string" },
        "axControls": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/axControl" },
                {
                  "properties": {
                    "role": { "const": "heading" },
                    "name": { "const": "Complete 60-second stereo effects rack" }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/axControl" },
                {
                  "properties": {
                    "role": { "const": "combobox" },
                    "name": { "const": "Engine" },
                    "relationships": { "minItems": 1 }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/axControl" },
                {
                  "properties": {
                    "role": { "const": "button" },
                    "name": { "const": "Start full validation" }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/axControl" },
                {
                  "properties": {
                    "role": { "const": "button" },
                    "name": { "const": "Cancel" }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/axControl" },
                {
                  "properties": {
                    "role": { "const": "progressbar" },
                    "name": { "const": "Validation phase" }
                  }
                }
              ]
            }
          ],
          "items": false
        }
      }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "bytes", "sha256"],
      "properties": {
        "file": { "type": "string", "pattern": "^screenshots/[a-z0-9-]+\\.png$" },
        "bytes": { "type": "integer", "minimum": 8 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "finalState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "output", "progress", "startDisabled", "cancelDisabled"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "output": { "type": "string" },
        "progress": { "type": "number", "minimum": 0, "maximum": 4 },
        "startDisabled": { "type": "boolean" },
        "cancelDisabled": { "type": "boolean" }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocksPerChannel",
        "blockInvocations",

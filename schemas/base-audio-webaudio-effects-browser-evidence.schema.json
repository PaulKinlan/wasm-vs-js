      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "sha256", "base64"],
      "properties": {
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "base64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$",
          "minLength": 1048,
          "maxLength": 1048
        }
      }

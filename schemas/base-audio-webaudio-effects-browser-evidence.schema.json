        "finalState": { "$ref": "#/$defs/finalState" },
        "network": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/networkEntry" }
        },
        "executedScripts": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/executedScript" }
        },
        "console": { "type": "array", "items": { "$ref": "#/$defs/consoleEntry" } },
        "exceptions": { "type": "array", "maxItems": 0 },
        "accessibility": { "$ref": "#/$defs/accessibility" },
        "screenshot": { "$ref": "#/$defs/screenshot" },
        "result": { "$ref": "#/$defs/result" },
        "execution": { "$ref": "#/$defs/execution" },
        "lifecycle": { "$ref": "#/$defs/lifecycle" }
      }
    },
    "completeScenario": {
      "allOf": [
        { "$ref": "#/$defs/scenarioCommonProperties" },
        {
          "required": ["result", "execution"],
          "properties": { "action": { "const": "complete" } }
        }
      ]
    },

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "permitId",
    "experimentId",
    "operation",
    "sourceCommit",
    "chromeBinary",
    "chromeSha256",
    "origin",
    "strata",
    "maximumLaunches",
    "profileRoot",
    "issuedAt",
    "expiresAt",
    "authorizationReference",
    "retryOf"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "permitId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$" },
    "experimentId": { "const": "m1-chrome-sum-u32-v1" },
    "operation": { "enum": ["collect-uninstrumented-headline-paired-corpus", "pilot-m1-corpus"] },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "chromeBinary": { "const": "/home/paulkinlan/.local/bin/google-chrome-stable" },
    "chromeSha256": { "const": "dea3ab8fba923b718920ef9d62570824f2dc0ab0c72d66d53f91b41de6570355" },
    "origin": { "const": "http://127.0.0.1:8787" },
    "strata": { "const": ["cold", "warm"] },
    "maximumLaunches": { "type": "integer", "minimum": 1, "maximum": 120 },
    "profileRoot": {
      "type": "string",
      "pattern": "^/tmp/wasm-vs-js-owned-profiles/[A-Za-z0-9._-]+$"
    },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "authorizationReference": { "type": "string", "minLength": 1, "maxLength": 256 },
    "retryOf": { "type": ["string", "null"] }
  }
}

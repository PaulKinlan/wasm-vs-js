{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PaulKinlan/wasm-vs-js/schemas/ml-numeric-kernels-build.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogId",
    "contractId",
    "sourceRepository",
    "sourceCommit",
    "sourceSha256",
    "fullSourceGraph",
    "build",
    "scalarProof",
    "artifact"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogId": { "const": "ml.numeric-kernels.v1" },
    "contractId": { "const": "ml.numeric-kernels.v1-controlled-scalar.v1" },
    "sourceRepository": { "const": "https://github.com/PaulKinlan/wasm-vs-js" },
    "sourceCommit": { "pattern": "^[a-f0-9]{40}$" },
    "sourceSha256": { "$ref": "#/$defs/sha256" },
    "fullSourceGraph": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cwd", "task", "command", "toolchain", "lockfile"],
      "properties": {
        "cwd": { "const": "." },
        "task": { "const": "deno task build:ml-numeric-kernels" },
        "command": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deno", "v8", "typescript", "clang"],
          "properties": {
            "deno": { "const": "2.9.0" },
            "v8": { "type": "string", "minLength": 1 },
            "typescript": { "type": "string", "minLength": 1 },
            "clang": { "const": "clang version 22.1.8" }
          }
        },
        "lockfile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": { "path": { "const": "deno.lock" }, "sha256": { "$ref": "#/$defs/sha256" } }
        }
      }
    },
    "scalarProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["simd", "vectorization", "autoVectorizationFlags", "fpContraction", "threads"],
      "properties": {
        "simd": { "const": false },
        "vectorization": { "const": false },
        "autoVectorizationFlags": {
          "type": "array",
          "prefixItems": [{ "const": "-fno-vectorize" }, { "const": "-fno-slp-vectorize" }],
          "items": false
        },
        "fpContraction": { "const": false },
        "threads": { "const": false }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "const": "public/artifacts/ml-numeric-kernels/ml-numeric-kernels.wasm" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" }
  }
}

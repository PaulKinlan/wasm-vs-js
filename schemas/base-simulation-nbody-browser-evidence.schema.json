{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wasm-vs-js.ai-focus.dev/schemas/base-simulation-nbody-browser-evidence.v1.json",
  "title": "Direct N-body workload Chrome correctness evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "collectedAt",
    "workloadId",
    "performanceClaims",
    "source",
    "collectionCommand",
    "browser",
    "server",
    "contract",
    "scenarios",
    "cleanup"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "evidenceId": {
      "const": "simulation-nbody-browser-correctness-v1"
    },
    "collectedAt": {
      "type": "string",
      "format": "date-time"
    },
    "workloadId": {
      "const": "simulation.nbody-cloth.v1"
    },
    "performanceClaims": {
      "type": "array",
      "maxItems": 0
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree",
        "files",
        "acceptedStaticSourceCommit",
        "cleanHeadVerifiedBeforeAndAfter"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/gitIdentity"
        },
        "tree": {
          "$ref": "#/$defs/gitIdentity"
        },
        "acceptedStaticSourceCommit": {
          "$ref": "#/$defs/gitIdentity"
        },
        "files": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "prefixItems": [
            {
              "$ref": "#/$defs/sourceFile",
              "type": "object",
              "properties": {
                "path": { "const": "scripts/collect-base-simulation-nbody-evidence.ts" }
              }
            },
            {
              "$ref": "#/$defs/sourceFile",
              "type": "object",
              "properties": { "path": { "const": "lib/canonical.ts" } }
            },
            {
              "$ref": "#/$defs/sourceFile",
              "type": "object",
              "properties": { "path": { "const": "lib/cdp-client.ts" } }
            },
            {
              "$ref": "#/$defs/sourceFile",
              "type": "object",
              "properties": { "path": { "const": "deploy.ts" } }
            },
            {
              "$ref": "#/$defs/sourceFile",
              "type": "object",
              "properties": { "path": { "const": "server.ts" } }
            },
            {
              "$ref": "#/$defs/sourceFile",
              "type": "object",
              "properties": { "path": { "const": "benchmarks/base/simulation-nbody/contract.js" } }
            },
            {
              "$ref": "#/$defs/sourceFile",
              "type": "object",
              "properties": { "path": { "const": "benchmarks/base/simulation-nbody/fixture.js" } }
            },
            {
              "$ref": "#/$defs/sourceFile",
              "type": "object",
              "properties": { "path": { "const": "benchmarks/base/simulation-nbody/engine.js" } }
            },
            {
              "$ref": "#/$defs/sourceFile",
              "type": "object",
              "properties": {
                "path": { "const": "public/demos/simulation-nbody-cloth/index.html" }
              }
            },
            {
              "$ref": "#/$defs/sourceFile",
              "type": "object",
              "properties": { "path": { "const": "public/demos/simulation-nbody-cloth/demo.js" } }
            },
            {
              "$ref": "#/$defs/sourceFile",
              "type": "object",
              "properties": { "path": { "const": "public/demos/simulation-nbody-cloth/worker.js" } }
            },
            {
              "$ref": "#/$defs/sourceFile",
              "type": "object",
              "properties": { "path": { "const": "public/styles.css" } }
            },
            {
              "$ref": "#/$defs/sourceFile",
              "type": "object",
              "properties": {
                "path": { "const": "public/artifacts/base-simulation-nbody/nbody.wasm" }
              }
            },
            {
              "$ref": "#/$defs/sourceFile",
              "type": "object",
              "properties": {
                "path": { "const": "public/artifacts/base-simulation-nbody/build-manifest.json" }
              }
            },
            {
              "$ref": "#/$defs/sourceFile",
              "type": "object",
              "properties": {
                "path": { "const": "schemas/base-simulation-nbody-browser-evidence.schema.json" }
              }
            }
          ],
          "items": false
        },
        "cleanHeadVerifiedBeforeAndAfter": {
          "const": true
        }
      }
    },
    "collectionCommand": {
      "type": "string",
      "pattern": "^deno run -A scripts/collect-base-simulation-nbody-evidence\\.ts --source-commit=[a-f0-9]{40} --chrome=.+ --output=.+\\.json$"
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "revision",
        "userAgent",
        "jsVersion",
        "executable",
        "requestedLaunchArguments",
        "effectiveCommandLine",
        "headless",
        "protocol"
      ],
      "properties": {
        "product": {
          "type": "string",
          "pattern": "^Chrome/[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "userAgent": {
          "type": "string",
          "minLength": 1
        },
        "jsVersion": {
          "type": "string",
          "minLength": 1
        },
        "executable": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "bytes",
            "sha256",
            "dev",
            "ino"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "dev": {
              "type": "integer",
              "minimum": 0
            },
            "ino": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "requestedLaunchArguments": {
          "type": "array",
          "minItems": 17,
          "maxItems": 17,
          "prefixItems": [
            { "const": "--headless=new" },
            { "const": "--no-sandbox" },
            { "const": "--disable-gpu" },
            { "const": "--disable-background-networking" },
            { "const": "--disable-component-update" },
            { "const": "--disable-default-apps" },
            { "const": "--disable-extensions" },
            { "const": "--disable-sync" },
            { "const": "--metrics-recording-only" },
            { "const": "--no-first-run" },
            { "const": "--enable-automation" },
            { "const": "--disable-cache" },
            { "const": "--window-size=1440,1200" },
            { "const": "--remote-debugging-address=127.0.0.1" },
            { "type": "string", "pattern": "^--remote-debugging-port=[0-9]+$" },
            { "type": "string", "pattern": "^--user-data-dir=/tmp/wasm-nbody-chrome-[^/]+$" },
            { "const": "about:blank" }
          ],
          "items": false
        },
        "effectiveCommandLine": {
          "type": "array",
          "minItems": 17,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "allOf": [
            { "contains": { "const": "--headless=new" } },
            { "contains": { "const": "--no-sandbox" } },
            { "contains": { "const": "--disable-gpu" } },
            { "contains": { "const": "--disable-background-networking" } },
            { "contains": { "const": "--disable-component-update" } },
            { "contains": { "const": "--disable-default-apps" } },
            { "contains": { "const": "--disable-extensions" } },
            { "contains": { "const": "--disable-sync" } },
            { "contains": { "const": "--metrics-recording-only" } },
            { "contains": { "const": "--no-first-run" } },
            { "contains": { "const": "--enable-automation" } },
            { "contains": { "const": "--disable-cache" } },
            { "contains": { "const": "--window-size=1440,1200" } },
            { "contains": { "const": "--remote-debugging-address=127.0.0.1" } },
            { "contains": { "type": "string", "pattern": "^--remote-debugging-port=[0-9]+$" } },
            {
              "contains": {
                "type": "string",
                "pattern": "^--user-data-dir=/tmp/wasm-nbody-chrome-[^/]+$"
              }
            },
            { "contains": { "const": "about:blank" } }
          ]
        },
        "headless": {
          "const": true
        },
        "protocol": {
          "const": "Chrome DevTools Protocol"
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "mode",
        "launcherPid"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "pattern": "^http://127\\.0\\.0\\.1:[0-9]+$"
        },
        "mode": {
          "const": "public"
        },
        "launcherPid": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targets",
        "timesteps",
        "checkpoints",
        "counterCount",
        "output",
        "excluded"
      ],
      "properties": {
        "targets": {
          "const": [
            "js-controlled",
            "wasm-linear-controlled"
          ]
        },
        "timesteps": {
          "const": 120
        },
        "checkpoints": {
          "const": [
            1,
            30,
            60,
            90,
            120
          ]
        },
        "counterCount": {
          "const": 14
        },
        "output": {
          "const": "text-only"
        },
        "excluded": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cloth",
            "rendering"
          ],
          "properties": {
            "cloth": {
              "const": {
                "status": "unavailable",
                "reason": "The independently accepted implementation contract explicitly excludes cloth."
              }
            },
            "rendering": {
              "const": {
                "status": "unavailable",
                "reason": "The route exposes a textual correctness oracle only; its acceptance screenshot is not benchmark rendering evidence."
              }
            }
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/scenario"
            },
            {
              "properties": {
                "id": {
                  "const": "js-controlled-complete"
                },
                "target": {
                  "const": "js-controlled"
                },
                "action": {
                  "const": "complete"
                }
              },
              "type": "object"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/scenario"
            },
            {
              "properties": {
                "id": {
                  "const": "wasm-linear-controlled-complete"
                },
                "target": {
                  "const": "wasm-linear-controlled"
                },
                "action": {
                  "const": "complete"
                }
              },
              "type": "object"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/scenario"
            },
            {
              "properties": {
                "id": {
                  "const": "cancel-lifecycle"
                },
                "target": {
                  "const": "js-controlled"
                },
                "action": {
                  "const": "cancel"
                }
              },
              "type": "object"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/scenario"
            },
            {
              "properties": {
                "id": {
                  "const": "timeout-lifecycle"
                },
                "target": {
                  "const": "js-controlled"
                },
                "action": {
                  "const": "timeout"
                }
              },
              "type": "object"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/scenario"
            },
            {
              "properties": {
                "id": {
                  "const": "pagehide-lifecycle"
                },
                "target": {
                  "const": "js-controlled"
                },
                "action": {
                  "const": "pagehide"
                }
              },
              "type": "object"
            }
          ]
        }
      ]
    },
    "cleanup": {
      "$ref": "#/$defs/cleanup"
    }
  },
  "$defs": {
    "gitIdentity": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "enum": [
            "scripts/collect-base-simulation-nbody-evidence.ts",
            "lib/canonical.ts",
            "lib/cdp-client.ts",
            "deploy.ts",
            "server.ts",
            "benchmarks/base/simulation-nbody/contract.js",
            "benchmarks/base/simulation-nbody/fixture.js",
            "benchmarks/base/simulation-nbody/engine.js",
            "public/demos/simulation-nbody-cloth/index.html",
            "public/demos/simulation-nbody-cloth/demo.js",
            "public/demos/simulation-nbody-cloth/worker.js",
            "public/styles.css",
            "public/artifacts/base-simulation-nbody/nbody.wasm",
            "public/artifacts/base-simulation-nbody/build-manifest.json",
            "schemas/base-simulation-nbody-browser-evidence.schema.json"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "action",
        "route",
        "lifecycleInjection",
        "finalState",
        "oracle",
        "console",
        "exceptions",
        "network",
        "executedAssets",
        "accessibility",
        "screenshot"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "enum": [
            "js-controlled",
            "wasm-linear-controlled"
          ]
        },
        "action": {
          "enum": [
            "complete",
            "cancel",
            "timeout",
            "pagehide"
          ]
        },
        "route": {
          "const": "/demos/simulation-nbody-cloth/"
        },
        "lifecycleInjection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "expression"
          ],
          "properties": {
            "kind": {
              "enum": [
                "none",
                "visible-cancel-control",
                "timeout-shortening",
                "pagehide-dispatch"
              ]
            },
            "expression": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "finalState": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "result",
            "startDisabled",
            "cancelDisabled"
          ],
          "properties": {
            "status": {
              "type": "string",
              "minLength": 1
            },
            "result": {
              "type": "string",
              "minLength": 1
            },
            "startDisabled": {
              "type": "boolean"
            },
            "cancelDisabled": {
              "type": "boolean"
            }
          }
        },
        "oracle": {
          "anyOf": [
            {
              "$ref": "#/$defs/textOracle"
            },
            {
              "type": "null"
            }
          ]
        },
        "console": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "session",
              "type",
              "arguments"
            ],
            "properties": {
              "session": {
                "enum": [
                  "page",
                  "worker"
                ]
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "arguments": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "exceptions": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "session",
              "text",
              "lineNumber"
            ],
            "properties": {
              "session": {
                "enum": [
                  "page",
                  "worker"
                ]
              },
              "text": {
                "type": "string"
              },
              "lineNumber": {
                "type": "number"
              }
            }
          }
        },
        "network": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/networkRequest"
          }
        },
        "executedAssets": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/executedAsset"
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": { "route": { "const": "/demos/simulation-nbody-cloth/" } },
                "required": ["route"]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": { "route": { "const": "/styles.css" } },
                "required": ["route"]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": { "route": { "const": "/demos/simulation-nbody-cloth/demo.js" } },
                "required": ["route"]
              }
            }
          ]
        },
        "accessibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inspectedAxNodes",
            "assertions"
          ],
          "properties": {
            "inspectedAxNodes": {
              "type": "integer",
              "minimum": 1
            },
            "assertions": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "languageEnglish",
                "mainLandmark",
                "namedHeading",
                "labelledTarget",
                "namedControls",
                "liveStatus",
                "keyboardResult"
              ],
              "properties": {
                "languageEnglish": {
                  "const": true
                },
                "mainLandmark": {
                  "const": true
                },
                "namedHeading": {
                  "const": true
                },
                "labelledTarget": {
                  "const": true
                },
                "namedControls": {
                  "const": true
                },
                "liveStatus": {
                  "const": true
                },
                "keyboardResult": {
                  "const": true
                }
              }
            }
          }
        },
        "screenshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "\\.screenshots/[a-z0-9-]+\\.png$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "complete"
              }
            },
            "required": [
              "action"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "oracle": {
                "$ref": "#/$defs/textOracle"
              },
              "lifecycleInjection": {
                "const": {
                  "kind": "none",
                  "expression": null
                }
              },
              "finalState": {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "Complete. Correctness output only; no duration was collected."
                  },
                  "startDisabled": {
                    "const": false
                  },
                  "cancelDisabled": {
                    "const": true
                  }
                }
              },
              "executedAssets": {
                "type": "array",
                "minItems": 7,
                "allOf": [
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "route": { "const": "/demos/simulation-nbody-cloth/worker.js" }
                      },
                      "required": ["route"]
                    }
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "route": { "const": "/benchmarks/base/simulation-nbody/contract.js" }
                      },
                      "required": ["route"]
                    }
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "route": { "const": "/benchmarks/base/simulation-nbody/fixture.js" }
                      },
                      "required": ["route"]
                    }
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "route": { "const": "/benchmarks/base/simulation-nbody/engine.js" }
                      },
                      "required": ["route"]
                    }
                  }
                ]
              }
            },
            "type": "object"
          },
          "else": {
            "properties": {
              "oracle": {
                "type": "null"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "action": {
                "const": "cancel"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "lifecycleInjection": {
                "const": {
                  "kind": "visible-cancel-control",
                  "expression": null
                }
              },
              "finalState": {
                "const": {
                  "status": "Cancelled. The worker was terminated.",
                  "result": "No completed result.",
                  "startDisabled": false,
                  "cancelDisabled": true
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "action": {
                "const": "timeout"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "lifecycleInjection": {
                "const": {
                  "kind": "timeout-shortening",
                  "expression": "(() => { const native=globalThis.setTimeout; globalThis.setTimeout=(callback,delay,...args)=>native(callback,delay===30000?1:delay,...args); })()"
                }
              },
              "finalState": {
                "const": {
                  "status": "Stopped after the 30-second correctness timeout.",
                  "result": "No completed result.",
                  "startDisabled": false,
                  "cancelDisabled": true
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "action": {
                "const": "pagehide"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "lifecycleInjection": {
                "const": {
                  "kind": "pagehide-dispatch",
                  "expression": "dispatchEvent(new PageTransitionEvent('pagehide'))"
                }
              },
              "finalState": {
                "const": {
                  "status": "Running 1,024 bodies for exactly 120 leapfrog timesteps in a fresh worker…",
                  "result": "No completed result.",
                  "startDisabled": false,
                  "cancelDisabled": true
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "target": {
                "const": "js-controlled"
              }
            },
            "required": [
              "target"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wasm-vs-js.ai-focus.dev/schemas/base-server-ssr-browser-evidence.v1.json",
  "title": "server.ssr-template.v1 parent-run Chrome browser evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "collectedAt",
    "source",
    "collectionCommand",
    "browser",
    "server",
    "instrumentation",
    "scenarios",
    "cleanup"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceId": { "const": "server-ssr-template-chrome-150-browser-evidence-v1" },
    "collectedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$"
    },
    "source": { "$ref": "#/$defs/source" },
    "collectionCommand": {
      "type": "string",
      "pattern": "^deno run -A scripts/collect-base-server-ssr-evidence\\.ts --chrome=.+ --output-dir=/"
    },
    "browser": { "$ref": "#/$defs/browser" },
    "server": { "$ref": "#/$defs/server" },
    "instrumentation": { "$ref": "#/$defs/instrumentation" },
    "scenarios": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        { "$ref": "#/$defs/completeJsScenario" },
        { "$ref": "#/$defs/completeWasmScenario" },
        { "$ref": "#/$defs/restartScenario" },
        { "$ref": "#/$defs/wrongTokenScenario" },
        { "$ref": "#/$defs/staleScenario" },
        { "$ref": "#/$defs/cancelScenario" },
        { "$ref": "#/$defs/timeoutScenario" },
        { "$ref": "#/$defs/pagehideScenario" }
      ],
      "items": false
    },
    "cleanup": { "$ref": "#/$defs/cleanup" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitIdentity": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "target": { "enum": ["js-controlled", "wasm-linear-controlled"] },
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "path",
        "contentType",
        "bytes",
        "sha256",
        "headBytesMatch"
      ],
      "properties": {
        "route": {
          "enum": [
            "/demos/server.ssr-template.v1/",
            "/styles.css",
            "/base-server-ssr-demo.js",
            "/base-server-ssr-worker.js",
            "/benchmarks/v1/server-ssr-template/workload.js",
            "/data/v1-implementation-registrations/server.ssr-template.v1.json",
            "/artifacts/base-server-ssr-template/build-manifest.json",
            "/artifacts/base-server-ssr-template/fixture-manifest.json",
            "/artifacts/base-server-ssr-template/output-manifest.json",
            "/artifacts/base-server-ssr-template/fixture.bin",
            "/artifacts/base-server-ssr-template/server-ssr-template.wasm",
            "/favicon.ico"
          ]
        },
        "path": {
          "enum": [
            "public/demos/server.ssr-template.v1/index.html",
            "public/styles.css",
            "public/base-server-ssr-demo.js",
            "public/base-server-ssr-worker.js",
            "benchmarks/v1/server-ssr-template/workload.js",
            "catalog/v1-implementation-registrations/server.ssr-template.v1.json",
            "public/artifacts/base-server-ssr-template/build-manifest.json",
            "public/artifacts/base-server-ssr-template/fixture-manifest.json",
            "public/artifacts/base-server-ssr-template/output-manifest.json",
            "public/artifacts/base-server-ssr-template/fixture.bin",
            "public/artifacts/base-server-ssr-template/server-ssr-template.wasm",
            "public/favicon.svg"
          ]
        },
        "contentType": {
          "enum": [
            "text/html",
            "text/css",
            "text/javascript",
            "application/json",
            "application/octet-stream",
            "application/wasm",
            "image/svg+xml"
          ]
        },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "headBytesMatch": { "const": true }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "headTree",
        "clean",
        "packageCommit",
        "collector",
        "packageSources",
        "files"
      ],
      "properties": {
        "head": { "$ref": "#/$defs/gitIdentity" },
        "headTree": { "$ref": "#/$defs/gitIdentity" },
        "clean": { "const": true },
        "packageCommit": { "$ref": "#/$defs/gitIdentity" },
        "collector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "bytes", "sha256", "headBytesMatch"],
          "properties": {
            "path": { "const": "scripts/collect-base-server-ssr-evidence.ts" },
            "bytes": { "type": "integer", "minimum": 1 },
            "sha256": { "$ref": "#/$defs/sha256" },
            "headBytesMatch": { "const": true }
          }
        },
        "packageSources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/packageSource" }
        },
        "files": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/fileRecord" }
        }
      }
    },
    "packageSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "packageCommitBytesMatch"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "packageCommitBytesMatch": { "const": true }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "revision",
        "userAgent",
        "jsVersion",
        "executable",
        "launchArguments",
        "headless",
        "protocol",
        "debuggerOrigin"
      ],
      "properties": {
        "product": { "const": "Chrome/150.0.7871.24" },
        "revision": { "type": "string", "minLength": 1 },
        "userAgent": { "type": "string", "minLength": 1 },
        "jsVersion": { "type": "string", "minLength": 1 },
        "executable": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "bytes", "sha256"],
          "properties": {
            "path": { "type": "string", "pattern": "^/" },
            "bytes": { "type": "integer", "minimum": 1 },
            "sha256": {
              "const": "dea3ab8fba923b718920ef9d62570824f2dc0ab0c72d66d53f91b41de6570355"
            }
          }
        },
        "launchArguments": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "uniqueItems": true,
          "prefixItems": [
            { "const": "--headless=new" },
            { "const": "--no-sandbox" },
            { "const": "--disable-gpu" },
            { "const": "--disable-background-networking" },
            { "const": "--disable-component-update" },
            { "const": "--disable-default-apps" },
            { "const": "--disable-extensions" },
            { "const": "--disable-sync" },
            { "const": "--metrics-recording-only" },
            { "const": "--no-first-run" },
            { "const": "--hide-scrollbars" },
            { "const": "--window-size=1440,1200" },
            { "const": "--remote-debugging-address=127.0.0.1" },
            { "type": "string", "pattern": "^--remote-debugging-port=[0-9]+$" },
            {
              "type": "string",
              "pattern": "^--user-data-dir=/tmp/wasm-base-server-ssr-chrome-"
            },
            { "const": "about:blank" }
          ],
          "items": false
        },
        "headless": { "const": true },
        "protocol": { "const": "Chrome DevTools Protocol" },
        "debuggerOrigin": {
          "type": "string",
          "pattern": "^http://127\\.0\\.0\\.1:[0-9]+$"
        }
      }
    },
    "preflightRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "bytes", "sha256"],
      "properties": {
        "route": { "type": "string", "pattern": "^/" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "host",
        "mode",
        "executable",
        "arguments",
        "launcherPid",
        "preflight"
      ],
      "properties": {
        "origin": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]+$" },
        "host": { "const": "127.0.0.1" },
        "mode": { "const": "public" },
        "executable": { "type": "string", "pattern": "^/" },
        "arguments": {
          "const": [
            "run",
            "--allow-env=PORT,HOST,SERVER_MODE",
            "--allow-net=127.0.0.1",
            "--allow-read=.",
            "deploy.ts"
          ]
        },
        "launcherPid": { "type": "integer", "minimum": 1 },
        "preflight": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/preflightRecord" }
        }
      }
    },
    "instrumentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["injectionMethod", "sourceBytes", "sourceSha256", "purpose"],
      "properties": {
        "injectionMethod": { "const": "Page.addScriptToEvaluateOnNewDocument" },
        "sourceBytes": { "type": "integer", "minimum": 1 },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "purpose": {
          "const": "observe and deterministically exercise token and owned-worker lifecycle guards"
        }
      }
    },
    "pageState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heading",
        "status",
        "output",
        "bodyText",
        "startDisabled",
        "cancelDisabled",
        "target"
      ],
      "properties": {
        "heading": { "const": "Render 1,000 catalog responses" },
        "status": { "type": "string", "minLength": 1 },
        "output": { "type": "string" },
        "bodyText": { "type": "string", "minLength": 1 },
        "startDisabled": { "type": "boolean" },
        "cancelDisabled": { "type": "boolean" },
        "target": { "$ref": "#/$defs/target" }
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responses",
        "parsed-fields",
        "template-tokens",
        "text-escapes",
        "attribute-escapes",
        "url-escapes",
        "integer-formats",
        "date-formats",
        "input-bytes",
        "output-bytes",
        "allocations",
        "boundary-crossings"
      ],
      "properties": {
        "responses": { "const": 1000 },
        "parsed-fields": { "const": 7000 },
        "template-tokens": { "const": 23000 },
        "text-escapes": { "const": 2000 },
        "attribute-escapes": { "const": 1000 },
        "url-escapes": { "const": 2000 },
        "integer-formats": { "const": 4000 },
        "date-formats": { "const": 2000 },
        "input-bytes": { "const": 91442 },
        "output-bytes": { "const": 426192 },
        "allocations": { "const": 1 },
        "boundary-crossings": { "enum": [0, 1] }
      }
    },
    "responseDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "sha256"],
      "properties": {
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "routeRender": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "responses",
        "completeOutputSha256",
        "completeOutputBytes",
        "counters",
        "firstResponse",
        "lastResponse",
        "displayedResultText",
        "displayedResultTextSha256",
        "documentBodyTextSha256"
      ],
      "properties": {
        "target": { "$ref": "#/$defs/target" },
        "responses": { "const": 1000 },
        "completeOutputSha256": {
          "const": "330a49b560410f667eba4ae3baa9cce1f661201f84d7ea703a91a36835dbcedc"
        },
        "completeOutputBytes": { "const": 426192 },
        "counters": { "$ref": "#/$defs/counters" },
        "firstResponse": { "$ref": "#/$defs/responseDigest" },
        "lastResponse": { "$ref": "#/$defs/responseDigest" },
        "displayedResultText": {
          "type": "string",
          "pattern": "^Target: (js-controlled|wasm-linear-controlled)\\nResponses: 1000\\nComplete output SHA-256: 330a49b560410f667eba4ae3baa9cce1f661201f84d7ea703a91a36835dbcedc"
        },
        "displayedResultTextSha256": { "$ref": "#/$defs/sha256" },
        "documentBodyTextSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "eventData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["complete", "error"] },
        "token": { "type": "integer", "minimum": 1 },
        "target": { "$ref": "#/$defs/target" },
        "text": { "type": "string" }
      }
    },
    "eventDetail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "url": { "type": "string", "minLength": 1 },
        "mode": {
          "enum": ["normal", "wrong-token", "stale", "cancel", "timeout", "pagehide"]
        },
        "data": { "$ref": "#/$defs/eventData" },
        "token": { "type": "integer", "minimum": 1 }
      }
    },
    "lifecycleEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "detail"],
      "properties": {
        "kind": {
          "enum": [
            "instrumentation-ready",
            "worker-created",
            "worker-posted",
            "wrong-token-dispatched",
            "worker-held",
            "synthetic-message-dispatched",
            "worker-released",
            "worker-terminated"
          ]
        },
        "detail": { "$ref": "#/$defs/eventDetail" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "assertions"],
      "properties": {
        "events": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/lifecycleEvent" }
        },
        "assertions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "consoleRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "arguments"],
      "properties": {
        "type": { "type": "string", "not": { "const": "error" } },
        "arguments": { "type": "array", "items": { "type": "string" } }
      }
    },
    "exceptionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "lineNumber"],
      "properties": {
        "text": { "type": "string" },
        "lineNumber": { "type": "number" }
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "value": { "type": "string" }
      }
    },
    "networkRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "method",
        "resourceType",
        "status",
        "statusText",
        "protocol",
        "mimeType",
        "headers",
        "fromDiskCache",
        "fromServiceWorker",
        "failed",
        "errorText",
        "bodyBytes",
        "bodySha256",
        "sourcePath"
      ],
      "properties": {
        "url": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/" },
        "method": { "const": "GET" },
        "resourceType": { "type": "string", "minLength": 1 },
        "status": { "const": 200 },
        "statusText": { "type": "string" },
        "protocol": { "type": "string", "minLength": 1 },
        "mimeType": { "type": "string", "minLength": 1 },
        "headers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/header" }
        },
        "fromDiskCache": { "const": false },
        "fromServiceWorker": { "const": false },
        "failed": { "const": false },
        "errorText": { "type": "null" },
        "bodyBytes": { "type": "integer", "minimum": 1 },
        "bodySha256": { "$ref": "#/$defs/sha256" },
        "sourcePath": { "type": "string", "minLength": 1 }
      }
    },
    "axNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "name", "ignored"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "ignored": { "const": false }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inspectedBy", "nodes", "assertions"],
      "properties": {
        "inspectedBy": { "const": "Accessibility.getFullAXTree" },
        "nodes": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/axNode" }
        },
        "assertions": {
          "const": [
            "named level-one heading present",
            "named target combobox present",
            "named Start and Cancel buttons present",
            "live status role present"
          ]
        }
      }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^screenshots/[a-z0-9-]+\\.png$" },
        "bytes": { "type": "integer", "minimum": 8 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "scenarioBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mode",
        "targetSequence",
        "finalState",
        "routeRender",
        "lifecycle",
        "console",
        "exceptions",
        "network",
        "accessibility",
        "screenshot"
      ],
      "properties": {
        "id": {
          "enum": [
            "complete-js",
            "complete-wasm",
            "restart-js-to-wasm",
            "wrong-token",
            "stale-after-restart",
            "cancel",
            "timeout",
            "pagehide"
          ]
        },
        "mode": {
          "enum": ["normal", "wrong-token", "stale", "cancel", "timeout", "pagehide"]
        },
        "targetSequence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/target" }
        },
        "finalState": { "$ref": "#/$defs/pageState" },
        "routeRender": {
          "anyOf": [{ "$ref": "#/$defs/routeRender" }, { "type": "null" }]
        },
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "console": { "type": "array", "items": { "$ref": "#/$defs/consoleRecord" } },
        "exceptions": { "const": [] },
        "network": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/networkRecord" }
        },
        "accessibility": { "$ref": "#/$defs/accessibility" },
        "screenshot": { "$ref": "#/$defs/screenshot" }
      }
    },
    "completeJsScenario": {
      "allOf": [
        { "$ref": "#/$defs/scenarioBase" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "complete-js" },
            "mode": { "const": "normal" },
            "targetSequence": { "const": ["js-controlled"] }
          }
        }
      ]
    },
    "completeWasmScenario": {
      "allOf": [
        { "$ref": "#/$defs/scenarioBase" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "complete-wasm" },
            "mode": { "const": "normal" },
            "targetSequence": { "const": ["wasm-linear-controlled"] }
          }
        }
      ]
    },
    "restartScenario": {
      "allOf": [
        { "$ref": "#/$defs/scenarioBase" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "restart-js-to-wasm" },
            "mode": { "const": "normal" },
            "targetSequence": { "const": ["js-controlled", "wasm-linear-controlled"] }
          }
        }
      ]
    },
    "wrongTokenScenario": {
      "allOf": [
        { "$ref": "#/$defs/scenarioBase" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "wrong-token" },
            "mode": { "const": "wrong-token" },
            "targetSequence": { "const": ["js-controlled"] }
          }
        }
      ]
    },
    "staleScenario": {
      "allOf": [
        { "$ref": "#/$defs/scenarioBase" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "stale-after-restart" },
            "mode": { "const": "stale" },
            "targetSequence": { "const": ["js-controlled", "wasm-linear-controlled"] }
          }
        }
      ]
    },
    "cancelScenario": {
      "allOf": [
        { "$ref": "#/$defs/scenarioBase" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "cancel" },
            "mode": { "const": "cancel" },
            "targetSequence": { "const": ["js-controlled"] }
          }
        }
      ]
    },
    "timeoutScenario": {
      "allOf": [
        { "$ref": "#/$defs/scenarioBase" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "timeout" },
            "mode": { "const": "timeout" },
            "targetSequence": { "const": ["js-controlled"] }
          }
        }
      ]
    },
    "pagehideScenario": {
      "allOf": [
        { "$ref": "#/$defs/scenarioBase" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "pagehide" },
            "mode": { "const": "pagehide" },
            "targetSequence": { "const": ["js-controlled"] }
          }
        }
      ]
    },
    "processIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "parentPid", "startTimeTicks", "executable"],
      "properties": {
        "pid": { "type": "integer", "minimum": 1 },
        "parentPid": { "type": "integer", "minimum": 0 },
        "startTimeTicks": { "type": "string", "pattern": "^[0-9]+$" },
        "executable": { "type": "string", "pattern": "^/" }
      }
    },
    "exitStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "code", "signal"],
      "properties": {
        "success": { "type": "boolean" },
        "code": { "type": "integer" },
        "signal": { "type": ["string", "null"] }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browser", "profile", "server"],
      "properties": {
        "browser": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "launcher",
            "observedProcesses",
            "requested",
            "signals",
            "exit",
            "processesAbsent"
          ],
          "properties": {
            "launcher": { "$ref": "#/$defs/processIdentity" },
            "observedProcesses": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/processIdentity" }
            },
            "requested": { "const": "Browser.close" },
            "signals": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["pid", "signal"],
                "properties": {
                  "pid": { "type": "integer", "minimum": 1 },
                  "signal": { "enum": ["SIGTERM", "SIGKILL"] }
                }
              }
            },
            "exit": { "$ref": "#/$defs/exitStatus" },
            "processesAbsent": { "const": true }
          }
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "initiallyEmpty", "removed", "absent"],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/tmp/wasm-base-server-ssr-chrome-"
            },
            "initiallyEmpty": { "const": true },
            "removed": { "const": true },
            "absent": { "const": true }
          }
        },
        "server": {
          "type": "object",
          "additionalProperties": false,
          "required": ["launcher", "signal", "exit", "processAbsent"],
          "properties": {
            "launcher": { "$ref": "#/$defs/processIdentity" },
            "signal": { "enum": ["SIGTERM", "SIGKILL"] },
            "exit": { "$ref": "#/$defs/exitStatus" },
            "processAbsent": { "const": true }
          }
        }
      }
    }
  }
}

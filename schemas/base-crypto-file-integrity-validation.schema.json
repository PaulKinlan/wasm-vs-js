{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wasm-vs-js.paulkinlan-ea.deno.net/evidence/base/crypto.file-integrity.v1/validation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workloadId",
    "status",
    "sourceRevision",
    "runtime",
    "exactInputs",
    "oracle",
    "cases",
    "totals",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workloadId": { "const": "crypto.file-integrity.v1" },
    "status": { "const": "complete-correctness-validation" },
    "sourceRevision": { "type": "string", "pattern": "^(WORKTREE-CANDIDATE|[a-f0-9]{40})$" },
    "runtime": { "type": "object" },
    "exactInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registrationRawSha256", "buildManifestRawSha256", "artifactRawSha256"],
      "properties": {
        "registrationRawSha256": { "$ref": "#/$defs/hash" },
        "buildManifestRawSha256": { "$ref": "#/$defs/hash" },
        "artifactRawSha256": { "$ref": "#/$defs/hash" }
      }
    },
    "oracle": { "type": "object" },
    "cases": {
      "type": "array",
      "minItems": 36,
      "maxItems": 36,
      "items": { "$ref": "#/$defs/case" }
    },
    "totals": { "type": "object" },
    "limitations": { "type": "object" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "kind",
        "byteLength",
        "schedule",
        "digestSha256",
        "expectedDigestSha256",
        "counters",
        "passed"
      ],
      "properties": {
        "target": { "enum": ["js-controlled", "wasm-linear-controlled"] },
        "kind": { "enum": ["seeded-pseudorandom", "all-zero"] },
        "byteLength": { "enum": [1048576, 16777216, 268435456] },
        "schedule": { "enum": [1024, 65536, "whole-buffer"] },
        "digestSha256": { "$ref": "#/$defs/hash" },
        "expectedDigestSha256": { "$ref": "#/$defs/hash" },
        "counters": { "type": "object" },
        "passed": { "const": true }
      }
    }
  }
}

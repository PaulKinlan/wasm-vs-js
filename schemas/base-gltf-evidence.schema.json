{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PaulKinlan/wasm-vs-js/schemas/base-gltf-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workloadId",
    "status",
    "sourceCommit",
    "assertions",
    "semanticOutputSha256",
    "browserEvidence",
    "performanceClaims"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workloadId": { "const": "graphics.gltf-viewer.v1" },
    "status": { "const": "static-validation-passed-browser-pending" },
    "sourceCommit": { "$ref": "#/$defs/commit" },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogImmutable",
        "rightsAudited",
        "dracoTargetsIndependentPayloads",
        "gltfParsedByBothTargets",
        "all600Frames",
        "all2046Indices",
        "all406Vertices",
        "pickTraceComplete",
        "cpuRasterizedFrames",
        "retainedRasterFrames",
        "countersReconciled",
        "completeOutputEqual",
        "routeLifecycle"
      ],
      "properties": {
        "catalogImmutable": { "const": true },
        "rightsAudited": { "const": true },
        "dracoTargetsIndependentPayloads": { "const": true },
        "gltfParsedByBothTargets": { "const": true },
        "all600Frames": { "const": true },
        "all2046Indices": { "const": true },
        "all406Vertices": { "const": true },
        "pickTraceComplete": { "const": true },
        "cpuRasterizedFrames": { "const": 600 },
        "retainedRasterFrames": { "const": 600 },
        "countersReconciled": { "const": true },
        "completeOutputEqual": { "const": true },
        "routeLifecycle": {
          "const": "covered by static tests; parent-owned retained Chrome evidence pending"
        }
      }
    },
    "semanticOutputSha256": {
      "const": "5fad101bb540b089d6bd1769c87540eec6f9bfe07ebbe05fa35001358d32a054"
    },
    "browserEvidence": { "const": "unavailable-pending-authoritative-controller" },
    "performanceClaims": { "type": "array", "maxItems": 0 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
  }
}

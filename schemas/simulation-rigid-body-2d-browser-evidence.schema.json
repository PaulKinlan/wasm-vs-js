      "type": "object",
      "additionalProperties": false,
      "required": ["role", "name", "ignored"],
      "properties": {
        "role": { "type": "string" },
        "name": { "type": "string" },
        "ignored": { "type": "boolean" }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inspectedBy", "nodes", "treeSha256", "assertions"],
      "properties": {
        "inspectedBy": { "const": "Accessibility.getFullAXTree" },
        "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/axNode" } },
        "treeSha256": { "$ref": "#/$defs/sha256" },
        "assertions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mainPresent",
            "headingNamed",
            "targetNamed",
            "startNamed",
            "cancelNamed",
            "statusPresent",
            "resultFocusable"
          ],
          "properties": {
            "mainPresent": { "const": true },
            "headingNamed": { "const": true },
            "targetNamed": { "const": true },
            "startNamed": { "const": true },
            "cancelNamed": { "const": true },
            "statusPresent": { "const": true },
            "resultFocusable": { "const": true }
          }
        }
      }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "bytes", "sha256"],
      "properties": {
        "file": { "type": "string", "pattern": "^screenshots/[a-z0-9-]+\\.png$" },
        "bytes": { "type": "integer", "minimum": 8 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "javascriptChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["javascriptMaximumError"],
      "properties": { "javascriptMaximumError": { "const": 0 } }
    },
    "wasmChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wasmMaximumError"],
      "properties": { "wasmMaximumError": { "const": 0 } }
    },
    "bothChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["javascriptMaximumError", "wasmMaximumError", "crossTarget"],
      "properties": {
        "javascriptMaximumError": { "const": 0 },
        "wasmMaximumError": { "const": 0 },
        "crossTarget": {
          "const": {
            "passed": true,
            "maximumAbsoluteError": 0,
            "maximumRelativeError": 0,
            "violations": 0
          }
        }
      }
    },
    "resultBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectedTarget",
        "executionTarget",
        "bodies",
        "joints",
        "timesteps",
        "checkpoints",
        "checkpointStateValues",
        "checkpointDigest",
        "metrics",
        "counters",
        "checks",
        "angularWork",
        "performanceClaim",
        "passed"
      ],
      "properties": {
        "selectedTarget": { "enum": ["javascript", "wasm-linear", "both"] },
        "executionTarget": { "enum": ["javascript", "wasm-linear"] },
        "bodies": { "const": 500 },
        "joints": { "const": 19 },
        "timesteps": { "const": 1800 },
        "checkpoints": { "const": 6 },
        "checkpointStateValues": { "const": 18000 },
        "checkpointDigest": { "const": "b54a6129" },
        "metrics": { "$ref": "#/$defs/metrics" },
        "counters": { "$ref": "#/$defs/counterBase" },
        "checks": {
          "oneOf": [
            { "$ref": "#/$defs/javascriptChecks" },
            { "$ref": "#/$defs/wasmChecks" },
            { "$ref": "#/$defs/bothChecks" }
          ]
        },
        "angularWork": { "$ref": "#/$defs/angularWork" },
        "performanceClaim": { "const": false },
        "passed": { "const": true }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "action",
        "target",
        "sessionOwnership",
        "statusHistory",
        "finalState",
        "lifecycleEvents",
        "network",
        "executedScripts",
        "console",
        "exceptions",
        "accessibility",
        "screenshot"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "action": {
          "enum": [
            "complete",
            "wrong-token",
            "stale-restart",
            "restart",
            "timeout",
            "cancel",
            "pagehide"
          ]
        },
        "target": { "enum": ["javascript", "wasm-linear", "both"] },
        "sessionOwnership": { "$ref": "#/$defs/sessionOwnership" },
        "statusHistory": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "finalState": { "$ref": "#/$defs/finalState" },
        "lifecycleEvents": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/lifecycleEvent" }
        },
        "network": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/network" } },
        "executedScripts": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/executedScript" }
        },
        "console": { "type": "array", "items": { "$ref": "#/$defs/console" } },
        "exceptions": { "type": "array", "maxItems": 0 },
        "accessibility": { "$ref": "#/$defs/accessibility" },
        "screenshot": { "$ref": "#/$defs/screenshot" },
        "result": { "$ref": "#/$defs/resultBase" },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checks"],
          "properties": {
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "completeScenario": {
      "allOf": [
        { "$ref": "#/$defs/scenario" },
        {
          "type": "object",
          "required": ["result"],
          "properties": {
            "result": { "$ref": "#/$defs/resultBase" },
            "lifecycle": false,
            "action": { "const": "complete" },
            "finalState": {
              "type": "object",
              "properties": {
                "status": { "const": "Complete. Correctness checks passed." },
                "progress": { "const": 3 },
                "startDisabled": { "const": false },
                "cancelDisabled": { "const": true }
              }
            }
          }
        }
      ]
    },
    "lifecycleScenario": {
      "allOf": [
        { "$ref": "#/$defs/scenario" },
        {
          "type": "object",
          "required": ["lifecycle"],
          "properties": {
            "result": false,
            "lifecycle": {
              "type": "object",
              "required": ["checks"],
              "properties": { "checks": { "type": "array" } }
            }
          }
        }
      ]
    },
    "javascriptComplete": {
      "allOf": [
        { "$ref": "#/$defs/completeScenario" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "javascript-complete" },
            "target": { "const": "javascript" },
            "result": {
              "type": "object",
              "properties": {
                "selectedTarget": { "const": "javascript" },
                "executionTarget": { "const": "javascript" },
                "counters": { "$ref": "#/$defs/javascriptCounters" },
                "checks": { "$ref": "#/$defs/javascriptChecks" }
              }
            }
          }
        }
      ]
    },
    "wasmComplete": {
      "allOf": [
        { "$ref": "#/$defs/completeScenario" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "wasm-linear-complete" },
            "target": { "const": "wasm-linear" },
            "result": {
              "type": "object",
              "properties": {
                "selectedTarget": { "const": "wasm-linear" },
                "executionTarget": { "const": "wasm-linear" },
                "counters": { "$ref": "#/$defs/wasmCounters" },
                "checks": { "$ref": "#/$defs/wasmChecks" }
              }
            }
          }
        }
      ]
    },
    "bothComplete": {
      "allOf": [
        { "$ref": "#/$defs/completeScenario" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "both-complete" },
            "target": { "const": "both" },
            "result": {
              "type": "object",
              "properties": {
                "selectedTarget": { "const": "both" },
                "executionTarget": { "const": "wasm-linear" },
                "counters": { "$ref": "#/$defs/wasmCounters" },
                "checks": { "$ref": "#/$defs/bothChecks" }
              }
            }
          }
        }
      ]
    },
    "wrongToken": {
      "allOf": [
        { "$ref": "#/$defs/lifecycleScenario" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "wrong-token" },
            "action": { "const": "wrong-token" },
            "target": { "const": "javascript" }
          }
        }
      ]
    },
    "staleRestart": {
      "allOf": [
        { "$ref": "#/$defs/lifecycleScenario" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "stale-restart" },
            "action": { "const": "stale-restart" },
            "target": { "const": "javascript" },
            "sessionOwnership": {
              "type": "object",
              "properties": { "workers": { "type": "array", "minItems": 2, "maxItems": 2 } }
            }
          }
        }
      ]
    },
    "restart": {
      "allOf": [
        { "$ref": "#/$defs/lifecycleScenario" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "restart" },
            "action": { "const": "restart" },
            "target": { "const": "wasm-linear" },
            "sessionOwnership": {
              "type": "object",
              "properties": { "workers": { "type": "array", "minItems": 2, "maxItems": 2 } }
            }
          }
        }
      ]
    },
    "timeout": {
      "allOf": [
        { "$ref": "#/$defs/lifecycleScenario" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "timeout" },
            "action": { "const": "timeout" },
            "target": { "const": "wasm-linear" },
            "finalState": {
              "type": "object",
              "properties": {
                "status": { "const": "Run stopped after the 30 second limit." },
                "startDisabled": { "const": false },
                "cancelDisabled": { "const": true }
              }
            }
          }
        }
      ]
    },
    "cancel": {
      "allOf": [
        { "$ref": "#/$defs/lifecycleScenario" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "cancel" },
            "action": { "const": "cancel" },
            "target": { "const": "javascript" },
            "finalState": {
              "type": "object",
              "properties": {
                "status": { "const": "Cancelled. The worker was terminated." },
                "result": { "const": "No result retained." },
                "progress": { "const": 0 },
                "startDisabled": { "const": false },
                "cancelDisabled": { "const": true }
              }
            }
          }
        }
      ]
    },
    "pagehide": {
      "allOf": [
        { "$ref": "#/$defs/lifecycleScenario" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "pagehide" },
            "action": { "const": "pagehide" },
            "target": { "const": "javascript" }
          }
        }
      ]
    },
    "cleanupCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "checkedAt", "remaining"],
      "properties": {
        "outcome": { "const": "success" },
        "checkedAt": { "type": "string", "format": "date-time" },
        "remaining": { "type": "array", "maxItems": 0 }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browserProcesses", "cgroup", "profile", "server"],
      "properties": {
        "browserProcesses": { "$ref": "#/$defs/cleanupCheck" },
        "cgroup": { "$ref": "#/$defs/cleanupCheck" },
        "profile": { "$ref": "#/$defs/cleanupCheck" },
        "server": { "$ref": "#/$defs/cleanupCheck" }
      }
    }
  }
}

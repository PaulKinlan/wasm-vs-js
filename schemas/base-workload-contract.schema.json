{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wasm-vs-js.example/schemas/base-workload-contract.schema.json",
  "title": "Frozen catalog supplemental implementation contract",
  "type": "object",
  "required": [
    "schemaVersion",
    "contractId",
    "catalogId",
    "catalogEntryId",
    "catalogMutation",
    "status",
    "track",
    "algorithmFamily",
    "equivalenceClass",
    "sourceBasis",
    "fixedWork",
    "fixtureRecipe",
    "floatingPointPolicy",
    "oracles",
    "requiredCounters",
    "targets",
    "performanceClaims"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "type": "string", "minLength": 1 },
    "catalogId": { "const": "workload-catalog-v1" },
    "catalogEntryId": { "type": "string", "pattern": "^[a-z0-9.-]+\\.v1$" },
    "catalogMutation": { "const": false },
    "status": {
      "enum": ["candidate-complete-correctness-package", "accepted-complete-correctness-package"]
    },
    "track": { "const": "controlled" },
    "algorithmFamily": { "type": "string", "minLength": 1 },
    "equivalenceClass": { "const": "algorithm-equivalent" },
    "sourceBasis": {
      "type": "object",
      "required": ["url", "archiveSha256", "licenseSpdx", "redistribution", "notice"]
    },
    "fixedWork": { "type": "object", "minProperties": 1 },
    "fixtureRecipe": { "type": "object", "minProperties": 1 },
    "floatingPointPolicy": {
      "type": "object",
      "required": [
        "storage",
        "operationOrder",
        "fmaContraction",
        "fastMath",
        "nanInfinity",
        "absoluteTolerance",
        "relativeTolerance"
      ]
    },
    "oracles": { "type": "object", "required": ["completeOutput"] },
    "requiredCounters": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "targets": {
      "type": "object",
      "required": ["javascript-controlled", "linear-wasm-controlled"]
    },
    "performanceClaims": { "type": "array", "maxItems": 0 }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PaulKinlan/wasm-vs-js/schemas/numeric-fft-spectral-filter-validation-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "authoritativePerformanceEvidence",
    "entryId",
    "implementationId",
    "variantId",
    "fixtureSha256",
    "completeOutputSha256",
    "quantizedOutputSha256",
    "oracle",
    "counters",
    "buildManifest",
    "performanceSamples",
    "sourceCommit"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "const": "supplemental-validation-record" },
    "authoritativePerformanceEvidence": { "const": false },
    "entryId": { "const": "numeric.fft-spectral-filter.v1" },
    "implementationId": { "const": "numeric-fft-spectral-filter-controlled-v1" },
    "variantId": { "enum": ["js-controlled", "wasm-linear-controlled"] },
    "fixtureSha256": { "$ref": "#/$defs/sha256" },
    "completeOutputSha256": { "$ref": "#/$defs/sha256" },
    "quantizedOutputSha256": { "$ref": "#/$defs/sha256" },
    "oracle": { "$ref": "#/$defs/oracleResult" },
    "counters": { "$ref": "#/$defs/counters" },
    "buildManifest": { "const": "/artifacts/numeric-fft-spectral-filter/build-manifest.json" },
    "performanceSamples": { "type": "array", "maxItems": 0 },
    "sourceCommit": { "$ref": "#/$defs/commit" }
  },
  "allOf": [
    {
      "if": { "properties": { "variantId": { "const": "js-controlled" } } },
      "then": {
        "properties": {
          "counters": {
            "properties": {
              "allocations": { "const": 1 },
              "boundary-crossings": { "const": 0 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "variantId": { "const": "wasm-linear-controlled" } } },
      "then": {
        "properties": {
          "counters": {
            "properties": {
              "allocations": { "const": 0 },
              "boundary-crossings": { "const": 1 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "tolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["absolute", "relative", "energyRelative"],
      "properties": {
        "absolute": { "const": 0.00025 },
        "relative": { "const": 0.0025 },
        "energyRelative": { "const": 0.0002 }
      }
    },
    "oracleResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "violations",
        "maxAbsolute",
        "maxRelative",
        "outputEnergy",
        "referenceEnergy",
        "energyRelative",
        "tolerance"
      ],
      "properties": {
        "passed": { "const": true },
        "violations": { "const": 0 },
        "maxAbsolute": { "type": "number", "minimum": 0 },
        "maxRelative": { "type": "number", "minimum": 0 },
        "outputEnergy": { "type": "number", "exclusiveMinimum": 0 },
        "referenceEnergy": { "type": "number", "exclusiveMinimum": 0 },
        "energyRelative": { "type": "number", "minimum": 0, "maximum": 0.0002 },
        "tolerance": { "$ref": "#/$defs/tolerance" }
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipelines",
        "samples",
        "forward-ffts",
        "inverse-ffts",
        "butterflies",
        "twiddle-pair-loads",
        "window-multiplies",
        "filter-scalar-multiplies",
        "inverse-scale-multiplies",
        "input-bytes",
        "output-bytes",
        "allocations",
        "boundary-crossings"
      ],
      "properties": {
        "pipelines": { "const": 1 },
        "samples": { "const": 1048576 },
        "forward-ffts": { "const": 1 },
        "inverse-ffts": { "const": 1 },
        "butterflies": { "const": 20971520 },
        "twiddle-pair-loads": { "const": 20971520 },
        "window-multiplies": { "const": 1048576 },
        "filter-scalar-multiplies": { "const": 2097152 },
        "inverse-scale-multiplies": { "const": 2097152 },
        "input-bytes": { "const": 20971512 },
        "output-bytes": { "const": 8388608 },
        "allocations": { "type": "integer", "minimum": 0 },
        "boundary-crossings": { "type": "integer", "minimum": 0 }
      }
    }
  }
}

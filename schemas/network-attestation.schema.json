{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "stratum", "origin", "assets", "unexpectedRequests", "attested"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "stratum": { "enum": ["cold", "warm"] },
    "origin": { "const": "http://127.0.0.1:8787" },
    "assets": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "fromDiskCache", "fromServiceWorker", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "fromDiskCache": { "type": "boolean" },
          "fromServiceWorker": { "const": false },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "unexpectedRequests": { "const": 0 },
    "attested": { "const": true }
  }
}

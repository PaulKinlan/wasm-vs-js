{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PaulKinlan/wasm-vs-js/schemas/run.schema.json",
  "title": "Immutable Wasm vs JavaScript benchmark run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "capturedAt",
    "suite",
    "benchmark",
    "variant",
    "build",
    "environment",
    "conditions",
    "correctness",
    "samples",
    "metrics",
    "failures",
    "payloadSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,96}$" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "commit"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "commit": { "$ref": "#/$defs/gitOid" },
        "collectorVersion": { "type": "string", "minLength": 1 }
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "tier", "inputManifestSha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "version": { "type": "integer", "minimum": 1 },
        "tier": { "enum": ["T0", "T1", "T2", "T3", "T4", "T5", "T6", "T7"] },
        "inputManifestSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "track", "cacheState"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "target": { "enum": ["javascript", "wasm-linear", "wasmgc", "hybrid"] },
        "track": { "enum": ["controlled", "optimized"] },
        "cacheState": { "enum": ["cold", "warm", "validation"] }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRepository",
        "sourceCommit",
        "sourceSha256",
        "artifacts",
        "lockfiles",
        "command",
        "toolchains",
        "flags",
        "footprint"
      ],
      "properties": {
        "sourceRepository": { "type": "string", "format": "uri", "maxLength": 1000 },
        "sourceCommit": { "$ref": "#/$defs/gitOid" },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "sha256"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 200 },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "lockfiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "sha256"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 200 },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "command": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "toolchains": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "flags": { "type": "array", "items": { "type": "string" } },
        "footprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rawBytes", "gzipBytes", "brotliBytes", "requestCount"],
          "properties": {
            "sourceBytes": { "$ref": "#/$defs/nonNegativeInteger" },
            "glueBytes": { "$ref": "#/$defs/nonNegativeInteger" },
            "rawBytes": { "$ref": "#/$defs/nonNegativeInteger" },
            "gzipBytes": { "$ref": "#/$defs/nonNegativeInteger" },
            "brotliBytes": { "$ref": "#/$defs/nonNegativeInteger" },
            "requestCount": { "$ref": "#/$defs/nonNegativeInteger" },
            "transferredBytes": { "$ref": "#/$defs/nonNegativeInteger" },
            "decodedBytes": { "$ref": "#/$defs/nonNegativeInteger" }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "browser",
        "os",
        "kernel",
        "architecture",
        "hardware",
        "physicalCores",
        "logicalCores",
        "ramBytes",
        "automation",
        "automationProtocol",
        "profileId",
        "freshLaunchId",
        "pairedBlockId",
        "viewport",
        "refreshHz"
      ],
      "properties": {
        "browser": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "engine", "headless", "launchArguments"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "build": { "type": "string" },
            "engine": { "type": "string", "minLength": 1 },
            "headless": { "type": "boolean" },
            "launchArguments": { "type": "array", "items": { "type": "string" } }
          }
        },
        "os": { "type": "string", "minLength": 1 },
        "kernel": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "hardware": { "type": "string", "minLength": 1 },
        "physicalCores": { "type": "integer", "minimum": 1 },
        "logicalCores": { "type": "integer", "minimum": 1 },
        "ramBytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "deviceModel": { "type": "string" },
        "automation": { "type": "string", "minLength": 1 },
        "automationProtocol": { "type": "string", "minLength": 1 },
        "profileId": { "type": "string", "minLength": 1 },
        "freshLaunchId": { "type": "string", "minLength": 1 },
        "pairedBlockId": { "type": "string", "minLength": 1 },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "dpr"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "dpr": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "refreshHz": { "type": "number", "exclusiveMinimum": 0 },
        "powerThermal": { "type": "string" }
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secureContext",
        "crossOriginIsolated",
        "serviceWorker",
        "network",
        "throttling",
        "profilerEnabled",
        "randomSeed",
        "orderIndex"
      ],
      "properties": {
        "secureContext": { "type": "boolean" },
        "crossOriginIsolated": { "type": "boolean" },
        "serviceWorker": { "enum": ["none", "controlled", "unknown"] },
        "network": { "type": "string", "minLength": 1 },
        "throttling": { "type": "string", "minLength": 1 },
        "profilerEnabled": { "type": "boolean" },
        "randomSeed": { "type": "string", "minLength": 1 },
        "orderIndex": { "type": "integer", "minimum": 0 }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": { "type": ["boolean", "string", "number", "null"] }
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "workCounters"],
      "properties": {
        "status": { "enum": ["passed", "failed", "blocked"] },
        "outputSha256": { "$ref": "#/$defs/sha256" },
        "detail": { "type": "string", "maxLength": 2000 },
        "workCounters": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/nonNegativeInteger" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"] },
          "then": { "required": ["outputSha256"] }
        }
      ]
    },
    "samples": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["iteration", "phase", "durationMs", "valid"],
        "properties": {
          "iteration": { "type": "integer", "minimum": 0 },
          "phase": { "type": "string", "pattern": "^[a-z][a-z0-9:_-]*$" },
          "durationMs": { "type": "number", "minimum": 0 },
          "valid": { "type": "boolean" },
          "exclusionReason": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "allOf": [
          {
            "if": { "properties": { "valid": { "const": false } }, "required": ["valid"] },
            "then": { "required": ["exclusionReason"] }
          }
        ]
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "failures": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "category", "detail"],
        "properties": {
          "stage": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "detail": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    },
    "rawRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "payloadSha256": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "correctness": { "properties": { "status": { "const": "passed" } } } }
      },
      "then": { "properties": { "samples": { "minItems": 1 } } }
    },
    {
      "if": {
        "properties": {
          "correctness": { "properties": { "status": { "enum": ["failed", "blocked"] } } }
        }
      },
      "then": {
        "properties": {
          "samples": { "items": { "properties": { "valid": { "const": false } } } },
          "failures": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitOid": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "nonNegativeInteger": { "type": "integer", "minimum": 0 },
    "availability": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": { "state": { "const": "supported" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reason"],
          "properties": {
            "state": { "const": "unavailable" },
            "reason": {
              "enum": ["api-absent", "entry-type-unsupported", "tool-unsupported", "not-collected"]
            },
            "detail": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reason"],
          "properties": {
            "state": { "const": "blocked" },
            "reason": {
              "enum": [
                "not-cross-origin-isolated",
                "security-error",
                "permissions-policy",
                "tao-redacted",
                "quota",
                "buffer-overflow",
                "resource-blocked",
                "automation-error"
              ]
            },
            "detail": { "type": "string" }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "metric", "availability", "scope", "comparability", "provenance"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "metric": { "type": "string", "minLength": 1 },
        "availability": { "$ref": "#/$defs/availability" },
        "value": { "type": ["number", "string", "boolean", "object", "array"] },
        "unit": { "enum": ["ms", "bytes", "count", "ratio", "boolean", "json"] },
        "scope": {
          "enum": [
            "window",
            "worker",
            "page-agent-clusters",
            "js-heap",
            "wasm-linear-memory",
            "renderer-process",
            "browser-process",
            "gpu-process",
            "os-process-tree",
            "network-request"
          ]
        },
        "comparability": {
          "enum": [
            "cross-browser-standardized",
            "cross-browser-with-conditions",
            "within-browser-only",
            "diagnostic-only"
          ]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "capturedAt"],
          "properties": {
            "source": {
              "enum": [
                "performance-timeline",
                "page-api",
                "cdp",
                "webdriver-bidi",
                "webdriver-classic",
                "firefox-profiler",
                "webkit-inspector",
                "os",
                "server"
              ]
            },
            "capturedAt": { "type": "string", "format": "date-time" },
            "protocolVersion": { "type": "string" },
            "rawRef": { "type": "string" }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": { "properties": { "state": { "const": "supported" } } }
            }
          },
          "then": { "required": ["value", "unit"] }
        },
        {
          "if": {
            "properties": {
              "availability": { "properties": { "state": { "enum": ["unavailable", "blocked"] } } }
            }
          },
          "then": { "not": { "required": ["value"] } }
        }
      ]
    }
  }
}

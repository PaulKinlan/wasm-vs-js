      "commitRule": "A block is committed only when both variant records pass correctness/work/hash validation and exact owned-process/profile cleanup passes.",
      "partialPairPolicy": "retain-as-failed-or-blocked-never-summarize",
      "substitutionsAllowed": false,
      "retriesAllowed": false,
      "slowValidSamplePolicy": "retain",
      "strataPoolingAllowed": false
    },
    "statistics": {
      "headlineInput": "committed-pairs-only",
      "withinLaunchVariantStatistic": "median-even-average-v1 of every finite valid scored post-calibration fixed-work sample",
      "pairedEstimator": {
        "transform": "natural-log of (wasm-linear-controlled within-launch median / js-controlled within-launch median)",
        "point": "median-even-average-v1 of finite per-launch paired log ratios",
        "reportedRatio": "exp(point)",
        "absoluteEffect": {
          "perLaunch": "wasm-linear-controlled within-launch median minus js-controlled within-launch median in milliseconds",
          "point": "median-even-average-v1 of finite per-launch absolute differences",
          "interval": "exact-distribution-free-sign-order-statistic-v1 using the same per-look alpha as the log-ratio interval"
        }
      },
      "absoluteDistributions": [
        "count",
        "median-even-average-v1",
        "mean",
        "p5-type7",
        "p25-type7",
        "p75-type7",
        "p95-type7",
        "p99-type7",
        "MAD-median-even-average-v1",
        "IQR-type7",
        "all raw samples"
      ],
      "confidenceInterval": {
        "algorithm": "exact-distribution-free-sign-order-statistic-v1",
        "parameter": "population median of finite committed paired values",
        "twoSidedAlphaPerAttemptLook": 0.01,
        "boundRule": "Sort n finite values ascending. Let k be the largest integer >=0 with 2*P(Binomial(n,0.5)<=k)<=0.01. Return one-based order statistics [X_(k+1), X_(n-k)]. If no such k exists, return [-Infinity,+Infinity]. Ties are retained.",
        "binomialArithmetic": "exact integer binomial coefficients divided by 2^n; no normal approximation",
        "nonfinitePolicy": "reject paired value before commitment; never coerce or remove after commitment",
        "tiePolicy": "retain every tied committed value",
        "medianEvenConvention": "arithmetic mean of the two central sorted finite values",
        "implementationId": "paired-statistics-v1"
      },
      "descriptiveBootstrap": {
        "role": "descriptive-sensitivity-only-never-confidence-or-stopping",
        "algorithm": "paired-percentile-bootstrap-type7-v1",
        "resamples": 10000,
        "prng": "xorshift32-v1",
        "baseSeed": "0x7a31c9e5",
        "zeroStateReplacement": "0x6d2b79f5",
        "stateTransition": "uint32 x ^= x << 13; x ^= x >>> 17; x ^= x << 5; output uint32 x",
        "wordToIndex": "multiply-high: floor(uint32_word * sample_count / 2^32)",
        "streamDerivation": "FNV-1a-32 UTF-8 of 0x + eight-lowercase-hex-baseSeed + colon + stratum + colon + attempted-checkpoint + colon + paired-log-ratio-v1, xor baseSeed uint32; replace zero state before first draw",
        "resampleUnit": "one derived per-launch paired log ratio; absolute differences and target medians are not bootstrap inputs",
        "pointPerResample": "median-even-average-v1 of the resampled per-launch paired log ratios",
        "percentiles": [
          0.005,
          0.5,
          0.995
        ],
        "percentileInterpolation": "type-7 linear interpolation: h=(N-1)*p, interpolate sorted[floor(h)] to sorted[ceil(h)]",
        "strataSeparate": true,
        "estimand": "median-even-average-v1 of per-launch natural-log(wasm-linear-controlled within-launch median / js-controlled within-launch median)",
        "inputContract": "Two equal-length arrays of finite positive committed within-launch medians, JavaScript first and Wasm second; derive exactly one natural-log ratio per paired launch internally."
      },
      "sequentialProtection": {
        "familyWiseAlpha": 0.05,
        "attemptLooksPerStratum": 5,
        "method": "Bonferroni over frozen attempted-launch checkpoints",
        "twoSidedAlphaPerAttemptLook": 0.01,
        "twoSidedConfidenceLevelPerAttemptLook": 0.99,
        "attemptCheckpoints": [

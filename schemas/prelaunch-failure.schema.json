{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blockId",
    "scheduleIndex",
    "stratum",
    "order",
    "attempted",
    "category",
    "reason",
    "cleanupLifecycle"
  ],
  "properties": {
    "blockId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
    "scheduleIndex": { "type": "integer", "minimum": 0, "maximum": 119 },
    "stratum": { "enum": ["cold", "warm"] },
    "order": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["js-controlled", "wasm-linear-controlled"] }
    },
    "attempted": { "const": false },
    "category": {
      "enum": [
        "failed-correctness",
        "failed-measurement",
        "blocked-containment",
        "blocked-cache",
        "blocked-provenance"
      ]
    },
    "reason": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "cleanupLifecycle": { "enum": ["verified-no-owned-launch", "unresolved-cleanup"] }
  }
}

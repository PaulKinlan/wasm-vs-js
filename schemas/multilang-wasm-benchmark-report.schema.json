{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wasm-vs-js.paulkinlan-ea.deno.net/schemas/multilang-wasm-benchmark-report.schema.json",
  "title": "MultiLanguageWasmBenchmarkReport",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "workloads",
    "summary"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "generatedAt": { "type": "string" },
    "toolchains": {
      "type": "object",
      "description": "Toolchain invocation summary per compiler family (informational)."
    },
    "workloads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "variants"
        ],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "variants": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "language",
                "toolchain",
                "binarySizeBytes",
                "coldInstantiateMs",
                "memoryPageCount",
                "importsCount",
                "exportsCount"
              ],
              "properties": {
                "language": { "type": "string" },
                "toolchain": { "type": "string" },
                "binarySizeBytes": { "type": "number" },
                "coldInstantiateMs": { "type": "number" },
                "warmExecutionMs": {
                  "anyOf": [{ "type": "number" }, { "type": "null" }],
                  "description": "Measured warm execution; absent when no comparable workload exists (footprint-only rows)."
                },
                "memoryPageCount": { "type": "number" },
                "importsCount": { "type": "number" },
                "exportsCount": { "type": "number" },
                "notes": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "totalVariantsTested",
        "keyInsights"
      ],
      "properties": {
        "totalVariantsTested": { "type": "number" },
        "keyInsights": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}

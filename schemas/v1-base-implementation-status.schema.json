{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wasm-vs-js.example/schemas/v1-base-implementation-status.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ledgerId", "status", "frozenCatalog", "coverage", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "ledgerId": { "const": "frozen-v1-supplemental-implementation-status" },
    "status": { "const": "descriptive-candidate-status-not-accepted-catalog" },
    "frozenCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "publicPath", "sha256", "immutable", "entryCount"],
      "properties": {
        "path": { "const": "catalog/workloads.v1.json" },
        "publicPath": { "const": "public/data/workloads.v1.json" },
        "sha256": { "const": "6665664f984683e5b7d3fdc8c1602198124844704c224a526d48be2f02edf9d4" },
        "immutable": { "const": "byte-for-byte" },
        "entryCount": { "const": 38 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptedImplementedEntries", "denominator", "candidatePackages", "statement"],
      "properties": {
        "acceptedImplementedEntries": { "const": 0 },
        "denominator": { "const": 38 },
        "candidatePackages": { "const": 1 },
        "statement": { "type": "string", "pattern": "0/38" }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "registrationId",
          "maturity",
          "targets",
          "fixedWork",
          "fixture",
          "buildManifest",
          "records",
          "interactiveDemo",
          "browserEvidence"
        ],
        "properties": {
          "id": { "const": "text.gc-document-edit.v1" },
          "registrationId": { "const": "text.gc-document-edit.v1-supplemental-registration-v1" },
          "maturity": {
            "const": "complete-local-correctness-candidate-awaiting-browser-and-independent-review"
          },
          "targets": { "const": ["javascript", "wasmgc"] },
          "fixedWork": { "type": "object" },
          "fixture": { "type": "object" },
          "buildManifest": { "type": "object" },
          "records": { "type": "array", "minItems": 2, "maxItems": 2 },
          "interactiveDemo": { "type": "object" },
          "browserEvidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "reason"],
            "properties": {
              "status": { "const": "unavailable" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}

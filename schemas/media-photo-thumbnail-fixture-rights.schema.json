{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wasm-vs-js.example/schemas/media-photo-thumbnail-fixture-rights.schema.json",
  "title": "media.photo-thumbnail.v1 fixture rights and acquisition manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "catalogWorkloadId",
    "catalogSha256",
    "fixtureState",
    "distributionMode",
    "source",
    "rightsAudit",
    "selection"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "manifestId": { "const": "media-photo-thumbnail-fixtures-v1" },
    "catalogWorkloadId": { "const": "media.photo-thumbnail.v1" },
    "catalogSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fixtureState": { "const": "frozen-download-recipe" },
    "distributionMode": { "const": "download-recipe-only" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "commitDate",
        "readmeSha256",
        "licensePath",
        "licenseSha256"
      ],
      "properties": {
        "repository": { "const": "https://github.com/gianni-rosato/gb82-image-set" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "commitDate": { "type": "string", "format": "date-time" },
        "readmeSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "licensePath": { "const": "LICENSE" },
        "licenseSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "rightsAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "licenseSpdx", "scopeEvidence", "redistributionPermission", "caveat"],
      "properties": {
        "status": { "const": "upstream-per-file-scope-confirmed" },
        "licenseSpdx": { "const": "CC0-1.0" },
        "scopeEvidence": { "type": "string", "minLength": 1 },
        "redistributionPermission": { "const": "permitted-by-CC0-1.0" },
        "caveat": { "type": "string", "minLength": 1 }
      }
    },
    "selection": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "subset",
          "sourcePath",
          "downloadUrl",
          "sha256",
          "byteLength",
          "width",
          "height",
          "pixelFormat",
          "colorSpace",
          "alpha",
          "exifOrientation",
          "licenseSpdx"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "subset": { "enum": ["GB82", "GB82-SC"] },
          "sourcePath": { "type": "string", "pattern": "^(png|sc-png)/[A-Za-z0-9_-]+\\.png$" },
          "downloadUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://raw\\.githubusercontent\\.com/gianni-rosato/gb82-image-set/[0-9a-f]{40}/(png|sc-png)/"
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "byteLength": { "type": "integer", "minimum": 1 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "pixelFormat": { "enum": ["rgb8", "indexed8"] },
          "colorSpace": { "const": "sRGB-D65" },
          "alpha": { "const": "opaque" },
          "exifOrientation": { "const": "absent-treat-as-1" },
          "licenseSpdx": { "const": "CC0-1.0" }
        }
      }
    }
  }
}

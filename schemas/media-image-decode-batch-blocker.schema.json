{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PaulKinlan/wasm-vs-js/schemas/media-image-decode-batch-blocker.schema.json",
  "title": "Blocked media image decode batch record",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 12,
  "maxProperties": 12,
  "required": [
    "schemaVersion",
    "recordId",
    "workloadId",
    "catalogRevision",
    "catalogPath",
    "catalogSha256",
    "status",
    "coverage",
    "fixedContract",
    "blockers",
    "deliberatelyAbsent",
    "resumeRequirements"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordId": {
      "const": "media-image-decode-batch-v1-blocker"
    },
    "workloadId": {
      "const": "media.image-decode-batch.v1"
    },
    "catalogRevision": {
      "const": "e836bf78313074da3a055621fb0c0291b8632b6c"
    },
    "catalogPath": {
      "const": "catalog/workloads.v1.json"
    },
    "catalogSha256": {
      "const": "6665664f984683e5b7d3fdc8c1602198124844704c224a526d48be2f02edf9d4"
    },
    "status": {
      "const": "blocked-before-implementation"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 6,
      "maxProperties": 6,
      "required": [
        "implementedCatalogEntry",
        "countedInFrozenV1Numerator",
        "testedEnginePair",
        "validationPackage",
        "interactiveDemo",
        "authoritativePerformanceResults"
      ],
      "properties": {
        "implementedCatalogEntry": {
          "const": false
        },
        "countedInFrozenV1Numerator": {
          "const": false
        },
        "testedEnginePair": {
          "const": false
        },
        "validationPackage": {
          "const": false
        },
        "interactiveDemo": {
          "const": false
        },
        "authoritativePerformanceResults": {
          "const": false
        }
      }
    },
    "fixedContract": {
      "const": {
        "formats": [
          "jpeg",
          "png",
          "webp",
          "avif",
          "jxl"
        ],
        "imagesPerFormat": 25,
        "totalImages": 125,
        "output": "complete RGBA",
        "nativeDecode": "separate-product-baseline-only"
      }
    },
    "blockers": {
      "const": [
        {
          "code": "fixture-rights-and-selection-unresolved",
          "severity": "blocker",
          "evidencePath": "benchmarks/v1/media-image-decode-batch/fixture-rights-audit.v1.json",
          "detail": "The immutable catalog row does not identify the exact 25 files for each format, their upstream revisions and URLs, per-file redistribution grants, or raw SHA-256 values. The required 125-image fixture cannot be frozen without inventing those decisions."
        },
        {
          "code": "genuine-javascript-jxl-decoder-unavailable",
          "severity": "blocker",
          "evidencePath": "benchmarks/v1/media-image-decode-batch/codec-feasibility-audit.v1.json",
          "detail": "No pinned genuine-JavaScript JPEG XL decoder was identified. Available JXL candidates execute WebAssembly. A Wasm-backed wrapper or browser-native decoder cannot be presented as the controlled JavaScript target."
        },
        {
          "code": "five-format-source-build-not-pinned",
          "severity": "blocker",
          "evidencePath": "benchmarks/v1/media-image-decode-batch/codec-feasibility-audit.v1.json",
          "detail": "No repository-pinned source graph and reproducible build covers JPEG, PNG, WebP, AVIF and JXL for both independent controlled targets, including transitive codec licenses, compiler flags and artifact hashes."
        }
      ]
    },
    "deliberatelyAbsent": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 7,
      "maxProperties": 7,
      "required": [
        "fixtureBytes",
        "fixtureHashes",
        "javascriptCodec",
        "linearWasmArtifact",
        "validationRecords",
        "demoRoute",
        "timingResults"
      ],
      "properties": {
        "fixtureBytes": {
          "const": true
        },
        "fixtureHashes": {
          "const": true
        },
        "javascriptCodec": {
          "const": true
        },
        "linearWasmArtifact": {
          "const": true
        },
        "validationRecords": {
          "const": true
        },
        "demoRoute": {
          "const": true
        },
        "timingResults": {
          "const": true
        }
      }
    },
    "resumeRequirements": {
      "const": [
        "Approve and pin exactly 25 named files for each of JPEG, PNG, WebP, AVIF and JXL, with an exact upstream revision, download URL, per-file license, redistribution decision and raw-byte SHA-256.",
        "Identify and audit a genuine JavaScript decoder that materially decodes JXL to complete RGBA without WebAssembly or a native browser codec.",
        "Pin independent JavaScript and linear-Wasm source graphs, codec versions, compiler and linker versions, build flags, ICC/color/alpha/orientation/chroma policy and per-format oracle tolerances.",
        "Only after both blockers close, implement all 125 decodes, complete-output validation, operative counters, worker lifecycle and retained browser evidence."
      ]
    }
  }
}

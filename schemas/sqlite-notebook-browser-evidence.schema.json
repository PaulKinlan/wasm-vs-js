        "effectiveArguments": {
          "type": "array",
          "minItems": 21,
          "maxItems": 21,
          "items": { "type": "string", "minLength": 1 }
        },
        "headless": { "const": true },
        "protocol": { "const": "Chrome DevTools Protocol" },
        "debuggerOrigin": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:[1-9][0-9]*$" },
        "profile": { "$ref": "#/$defs/profile" },
        "cgroup": { "$ref": "#/$defs/cgroup" },
        "processes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/process" } }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "host", "mode", "launcher"],
      "properties": {
        "origin": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:[1-9][0-9]*$" },
        "host": { "const": "127.0.0.1" },
        "mode": { "const": "public" },
        "launcher": { "$ref": "#/$defs/process" }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "targetId", "type", "parentSessionId"],
      "properties": {
        "sessionId": { "type": "string", "minLength": 1 },
        "targetId": { "type": "string", "minLength": 1 },
        "type": { "enum": ["page", "worker"] },
        "parentSessionId": { "type": ["string", "null"] }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browserContextId", "pageTargetId", "pageSessionId", "sessions"],
      "properties": {
        "browserContextId": { "type": "string", "minLength": 1 },
        "pageTargetId": { "type": "string", "minLength": 1 },
        "pageSessionId": { "type": "string", "minLength": 1 },
        "sessions": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/session" } }
      }
    },
    "finalState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "resultTextSha256",
        "bodyTextSha256",
        "startDisabled",
        "cancelDisabled",
        "progress"
      ],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "resultTextSha256": { "$ref": "#/$defs/sha256" },
        "bodyTextSha256": { "$ref": "#/$defs/sha256" },
        "startDisabled": { "type": "boolean" },
        "cancelDisabled": { "type": "boolean" },
        "progress": { "type": "integer", "minimum": 0, "maximum": 4 }
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "imports",
        "imported-rows",
        "queries",
        "scans",
        "joins",
        "groups",
        "windows",
        "sorts",
        "allocations",
        "boundary-crossings"

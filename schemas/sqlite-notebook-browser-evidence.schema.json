{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wasm-vs-js.ai-focus.dev/schemas/sqlite-notebook-browser-evidence.v1.json",
  "title": "database.sqlite-notebook.v1 authoritative owned CfT browser evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workload",
    "evidenceId",
    "collectedAt",
    "source",
    "browser",
    "server",
    "scenarios",
    "cleanup"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workload": { "const": "database.sqlite-notebook.v1" },
    "evidenceId": {
      "type": "string",
      "pattern": "^database-sqlite-notebook-browser-[a-f0-9]{12}$"
    },
    "collectedAt": { "type": "string", "format": "date-time" },
    "source": { "$ref": "#/$defs/source" },
    "browser": { "$ref": "#/$defs/browser" },
    "server": { "$ref": "#/$defs/server" },
    "scenarios": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/scenario" },
            {
              "type": "object",
              "required": ["result"],
              "properties": {
                "id": { "const": "complete-javascript" },
                "mode": { "const": "normal" },
                "targetSequence": { "const": ["javascript-controlled"] },
                "result": {
                  "type": "object",
                  "properties": { "variant": { "const": "javascript-controlled" } }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/scenario" },
            {
              "type": "object",
              "required": ["result"],
              "properties": {
                "id": { "const": "complete-wasm" },
                "mode": { "const": "normal" },
                "targetSequence": { "const": ["linear-wasm-controlled"] },
                "result": {
                  "type": "object",
                  "properties": { "variant": { "const": "linear-wasm-controlled" } }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/scenario" },
            {
              "type": "object",
              "required": ["result"],
              "properties": {
                "id": { "const": "wrong-token" },
                "mode": { "const": "wrong-token" },
                "targetSequence": { "const": ["javascript-controlled"] },
                "result": {
                  "type": "object",
                  "properties": { "variant": { "const": "javascript-controlled" } }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/scenario" },
            {
              "type": "object",
              "required": ["result"],
              "properties": {
                "id": { "const": "stale-after-restart" },
                "mode": { "const": "stale" },
                "targetSequence": { "const": ["javascript-controlled", "linear-wasm-controlled"] },
                "result": {
                  "type": "object",
                  "properties": { "variant": { "const": "linear-wasm-controlled" } }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/scenario" },
            {
              "type": "object",
              "required": ["result"],
              "properties": {
                "id": { "const": "restart" },
                "mode": { "const": "normal" },
                "targetSequence": { "const": ["javascript-controlled", "linear-wasm-controlled"] },
                "result": {
                  "type": "object",
                  "properties": { "variant": { "const": "linear-wasm-controlled" } }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/scenario" },
            {
              "type": "object",
              "not": { "type": "object", "required": ["result"], "properties": { "result": {} } },
              "properties": {
                "id": { "const": "timeout" },
                "mode": { "const": "timeout" },
                "targetSequence": { "const": ["linear-wasm-controlled"] }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/scenario" },
            {
              "type": "object",
              "not": { "type": "object", "required": ["result"], "properties": { "result": {} } },
              "properties": {
                "id": { "const": "cancel" },
                "mode": { "const": "cancel" },
                "targetSequence": { "const": ["javascript-controlled"] }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/scenario" },
            {
              "type": "object",
              "not": { "type": "object", "required": ["result"], "properties": { "result": {} } },
              "properties": {
                "id": { "const": "pagehide" },
                "mode": { "const": "pagehide" },
                "targetSequence": { "const": ["linear-wasm-controlled"] }
              }
            }
          ]
        }
      ],
      "items": false
    },
    "cleanup": { "$ref": "#/$defs/cleanup" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "git": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "parentPid", "startTimeTicks", "executable"],
      "properties": {
        "pid": { "type": "integer", "minimum": 2 },
        "parentPid": { "type": "integer", "minimum": 0 },
        "startTimeTicks": { "type": "string", "pattern": "^[0-9]+$" },
        "executable": { "type": "string", "pattern": "^/" }
      }
    },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "path", "bytes", "sha256", "gitBlob", "headBytesMatch"],
      "properties": {
        "route": { "type": "string", "pattern": "^/" },
        "path": { "type": "string", "pattern": "^(public|benchmarks|server\\.ts#)" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "gitBlob": { "$ref": "#/$defs/git" },
        "headBytesMatch": { "const": true }
      }
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "headBytesMatch"],
      "properties": {
        "path": { "const": "scripts/collect-sqlite-notebook-browser-evidence.ts" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "headBytesMatch": { "const": true }
      }
    },
    "endRecheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "head", "tree", "filesMatch", "collectorMatches", "checkedAt"],
      "properties": {
        "status": { "const": "clean" },
        "head": { "$ref": "#/$defs/git" },
        "tree": { "$ref": "#/$defs/git" },
        "filesMatch": { "const": true },
        "collectorMatches": { "const": true },
        "checkedAt": { "type": "string", "format": "date-time" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "tree",
        "acceptedParentCommit",
        "root",
        "initialClean",
        "collector",
        "files",
        "endRecheck"
      ],
      "properties": {
        "head": { "$ref": "#/$defs/git" },
        "tree": { "$ref": "#/$defs/git" },
        "acceptedParentCommit": { "const": "3a49f34aa7bd226ade54001fd503c346b4e4883c" },
        "root": { "type": "string", "pattern": "^/" },
        "initialClean": { "const": true },
        "collector": { "$ref": "#/$defs/collector" },
        "files": {
          "type": "array",
          "minItems": 17,
          "maxItems": 17,
          "items": { "$ref": "#/$defs/sourceFile" }
        },
        "endRecheck": { "$ref": "#/$defs/endRecheck" }
      }
    },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "bytes": { "const": 281758968 },
        "sha256": { "const": "dea3ab8fba923b718920ef9d62570824f2dc0ab0c72d66d53f91b41de6570355" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "dev", "ino", "mode", "initiallyEmpty"],
      "properties": {
        "path": { "type": "string", "pattern": "^/tmp/wasm-sqlite-notebook-chrome-" },
        "dev": { "type": "integer", "minimum": 0 },
        "ino": { "type": "integer", "minimum": 1 },
        "mode": { "const": 448 },
        "initiallyEmpty": { "const": true }
      }
    },
    "cgroupSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "pids"],
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "pids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 2 }
        }
      }
    },
    "cgroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "path",
        "dev",
        "ino",
        "controlGroup",
        "invocationId",
        "mainPid",
        "snapshots"
      ],
      "properties": {
        "unit": { "type": "string", "pattern": "^wasm-sqlite-notebook-[a-f0-9]{16}\\.service$" },
        "path": { "type": "string", "pattern": "^/sys/fs/cgroup/" },
        "dev": { "type": "integer", "minimum": 1 },
        "ino": { "type": "integer", "minimum": 1 },
        "controlGroup": { "type": "string", "pattern": "^/" },
        "invocationId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "mainPid": { "type": "integer", "minimum": 2 },
        "snapshots": {
          "type": "array",
          "minItems": 9,
          "items": { "$ref": "#/$defs/cgroupSnapshot" }
        }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "revision",
        "userAgent",
        "jsVersion",
        "executable",
        "launchArguments",
        "effectiveArguments",
        "headless",
        "protocol",
        "debuggerOrigin",
        "profile",
        "cgroup",
        "processes"
      ],
      "properties": {
        "product": { "const": "Chrome/150.0.7871.24" },
        "revision": { "type": "string", "minLength": 1 },
        "userAgent": { "type": "string", "minLength": 1 },
        "jsVersion": { "type": "string", "minLength": 1 },
        "executable": { "$ref": "#/$defs/executable" },
        "launchArguments": {
          "type": "array",
          "minItems": 20,
          "maxItems": 20,
          "prefixItems": [
            { "const": "--enable-automation" },
            { "const": "--headless=new" },
            { "const": "--no-sandbox" },
            { "const": "--disable-gpu" },
            { "const": "--disable-background-networking" },
            { "const": "--disable-component-update" },
            { "const": "--disable-default-apps" },
            { "const": "--disable-extensions" },
            { "const": "--disable-sync" },
            { "const": "--disable-crash-reporter" },
            { "const": "--disable-breakpad" },
            { "const": "--metrics-recording-only" },
            { "const": "--no-first-run" },
            { "const": "--no-default-browser-check" },
            { "const": "--hide-scrollbars" },
            { "const": "--window-size=1440,1200" },
            { "const": "--remote-debugging-address=127.0.0.1" },
            { "type": "string", "pattern": "^--remote-debugging-port=[1-9][0-9]*$" },
            { "type": "string", "pattern": "^--user-data-dir=/tmp/wasm-sqlite-notebook-chrome-" },
            { "const": "about:blank" }

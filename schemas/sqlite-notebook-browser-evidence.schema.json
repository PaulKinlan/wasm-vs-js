      "properties": {
        "imports": { "const": 3 },
        "imported-rows": { "const": 4192 },
        "queries": { "const": 8 },
        "scans": { "const": 14 },
        "joins": { "const": 6 },
        "groups": { "const": 6 },
        "windows": { "const": 2 },
        "sorts": { "const": 8 },
        "allocations": { "const": 11 },
        "boundary-crossings": { "enum": [0, 2] }
      }
    },
    "exactCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },

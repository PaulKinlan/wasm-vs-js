            },
            {
              "const": {
                "id": "javascript-engine",
                "sha256": "d7a6b9f0d11c60fcd1d1e5d574a13cf8bd02cfa1589a600ff701c6be3926cc87"
              }
            },
            {
              "const": {
                "id": "sqlite-glue",
                "sha256": "3f707d33cc51193ea446d02487dbda93223ac462aa8b4f512fee9a4122101c1e"
              }
            },
            {
              "const": {
                "id": "sqlite-wasm",
                "sha256": "02d7e48164395fa68f81c6ec33e9da5461be397dc57602ac0cd89b4bbba1d312"
              }
            },
            {
              "const": {
                "id": "dependencies",
                "sha256": "6269d01a0dd29410eca9e5774c8d9dd7cd71706b882ef9bd3dc68d7750620ffc"
              }
            },
            {
              "const": {
                "id": "fixture-manifest",
                "sha256": "5a42c7a7caf3e131846fbcfc2179de016b8f6de8501337172f0c7e534cc3845a"
              }
            },
            {
              "const": {
                "id": "customers",
                "sha256": "43392b2d16460b282d48cea531c610e7e60c6441e7cb52676f6ba1790f540243"
              }
            },
            {
              "const": {
                "id": "products",
                "sha256": "a7b935af4de4c21ac40b7a45fd5d7e214dcdf8cd611a756a9bae106615721aa1"
              }
            },
            {
              "const": {
                "id": "sales",
                "sha256": "40047e14c8445e9fcf49ac0f97bda606efa7485c6b6167b1ae11b0a84ed26d98"
              }
            },
            {
              "const": {
                "id": "reference",
                "sha256": "13aeb91156f6a11ddb62b6d08c5902bff44962cc886e4d689f4c54fddadc828a"
              }
            }
          ],
          "items": false
        },
        "results": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "prefixItems": [
            { "$ref": "#/$defs/query1" },
            { "$ref": "#/$defs/query2" },
            { "$ref": "#/$defs/query3" },
            { "$ref": "#/$defs/query4" },
            { "$ref": "#/$defs/query5" },
            { "$ref": "#/$defs/query6" },
            { "$ref": "#/$defs/query7" },
            { "$ref": "#/$defs/query8" }
          ],
          "items": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "variant": { "const": "javascript-controlled" } },
            "required": ["variant"]
          },
          "then": {
            "properties": {
              "counters": {
                "type": "object",
                "properties": { "boundary-crossings": { "const": 0 } }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "variant": { "const": "linear-wasm-controlled" } },
            "required": ["variant"]
          },
          "then": {
            "properties": {
              "counters": {
                "type": "object",
                "properties": { "boundary-crossings": { "const": 2 } }
              }
            }
          }
        }
      ]
    },
    "lifecycleEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "detailJson", "sessionId", "targetId"],
      "properties": {
        "kind": {
          "enum": [
            "instrumentation-ready",
            "blob-created",
            "worker-created",
            "worker-posted",
            "worker-held",
            "worker-released",
            "worker-terminated",
            "synthetic-message",
            "synthetic-error"
          ]
        },
        "detailJson": { "type": "string", "pattern": "^\\{" },
        "sessionId": { "type": "string", "minLength": 1 },
        "targetId": { "type": "string", "minLength": 1 }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "assertions"],
      "properties": {
        "events": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/lifecycleEvent" } },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "executionAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sessionId", "targetId", "url", "mimeType", "bytes", "sha256", "base64"],
      "properties": {
        "kind": { "enum": ["blob-created", "wasm-instantiated", "import-scripts"] },
        "sessionId": { "type": "string", "minLength": 1 },
        "targetId": { "type": "string", "minLength": 1 },
        "url": { "type": ["string", "null"] },
        "mimeType": { "type": ["string", "null"] },
        "bytes": { "type": ["integer", "null"], "minimum": 1 },
        "sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "base64": { "type": ["string", "null"] }
      }
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "targetId", "targetType", "type", "arguments"],
      "properties": {
        "sessionId": { "type": "string", "minLength": 1 },
        "targetId": { "type": "string", "minLength": 1 },
        "targetType": { "enum": ["page", "worker"] },
        "type": { "type": "string", "minLength": 1, "not": { "const": "error" } },
        "arguments": { "type": "array", "items": { "type": "string" } }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "targetId", "targetType", "text", "lineNumber", "columnNumber"],
      "properties": {
        "sessionId": { "type": "string", "minLength": 1 },
        "targetId": { "type": "string", "minLength": 1 },
        "targetType": { "enum": ["page", "worker"] },
        "text": { "type": "string", "minLength": 1 },
        "lineNumber": { "type": "integer", "minimum": 0 },
        "columnNumber": { "type": "integer", "minimum": 0 }
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": { "name": { "type": "string" }, "value": { "type": "string" } }
    },
    "supportedBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "bytes", "sha256", "sourcePath", "gitBlob"],
      "properties": {
        "status": { "const": "supported" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sourcePath": { "type": "string", "minLength": 1 },
        "gitBlob": { "$ref": "#/$defs/git" }
      }
    },
    "blobBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "const": "executed-blob-audit" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "sessionId",
        "targetId",
        "targetType",
        "url",
        "method",
        "resourceType",
        "status",
        "statusText",
        "protocol",
        "mimeType",
        "headers",
        "fromDiskCache",
        "fromServiceWorker",
        "failed",
        "errorText",
        "body"
      ],
      "properties": {
        "requestId": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "targetId": { "type": "string", "minLength": 1 },
        "targetType": { "enum": ["page", "worker"] },
        "url": {
          "type": "string",
          "pattern": "^(http://127\\.0\\.0\\.1:[1-9][0-9]*|blob:http://127\\.0\\.0\\.1:[1-9][0-9]*/)"
        },
        "method": { "const": "GET" },
        "resourceType": { "type": "string", "minLength": 1 },
        "status": { "const": 200 },
        "statusText": { "type": "string" },
        "protocol": { "type": "string" },
        "mimeType": { "type": "string" },
        "headers": { "type": "array", "items": { "$ref": "#/$defs/header" } },
        "fromDiskCache": { "const": false },
        "fromServiceWorker": { "const": false },
        "failed": { "const": false },
        "errorText": { "type": "null" },
        "body": { "oneOf": [{ "$ref": "#/$defs/supportedBody" }, { "$ref": "#/$defs/blobBody" }] }
      }
    },
    "axMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "nameSha256"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "nameSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inspectedBy",
        "visibleStatus",
        "visibleResultTextSha256",
        "resultDigestExposed",
        "matchingNodes",
        "assertions"
      ],
      "properties": {
        "inspectedBy": { "const": "Accessibility.getFullAXTree" },
        "visibleStatus": { "type": "string", "minLength": 1 },
        "visibleResultTextSha256": { "$ref": "#/$defs/sha256" },
        "resultDigestExposed": { "type": "boolean" },
        "matchingNodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/axMatch" } },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^screenshots/[a-z-]+\\.png$" },
        "bytes": { "type": "integer", "minimum": 8 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mode",
        "targetSequence",
        "ownership",
        "statusHistory",
        "finalState",
        "lifecycle",
        "executionAudits",
        "console",
        "exceptions",
        "network",
        "accessibility",
        "screenshot"
      ],
      "properties": {
        "id": {
          "enum": [
            "complete-javascript",
            "complete-wasm",
            "wrong-token",
            "stale-after-restart",
            "restart",
            "timeout",
            "cancel",
            "pagehide"
          ]
        },
        "mode": { "enum": ["normal", "wrong-token", "stale", "timeout", "cancel", "pagehide"] },
        "targetSequence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "enum": ["javascript-controlled", "linear-wasm-controlled"] }
        },
        "ownership": { "$ref": "#/$defs/ownership" },
        "statusHistory": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "finalState": { "$ref": "#/$defs/finalState" },
        "result": { "$ref": "#/$defs/result" },
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "executionAudits": { "type": "array", "items": { "$ref": "#/$defs/executionAudit" } },
        "console": { "type": "array", "items": { "$ref": "#/$defs/console" } },
        "exceptions": { "type": "array", "maxItems": 0, "items": { "$ref": "#/$defs/exception" } },
        "network": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/network" } },
        "accessibility": { "$ref": "#/$defs/accessibility" },
        "screenshot": { "$ref": "#/$defs/screenshot" }
      },
      "allOf": [
        {
          "if": { "required": ["result"], "properties": { "result": {} } },
          "then": {
            "properties": {
              "executionAudits": { "type": "array", "minItems": 3 },
              "accessibility": {
                "type": "object",
                "properties": { "resultDigestExposed": { "const": true } }
              }
            }
          }
        }
      ]
    },
    "cleanupSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "remainingPids"],
      "properties": {
        "outcome": { "const": "success" },
        "remainingPids": { "type": "array", "maxItems": 0 }
      }
    },
    "sessionCleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "browserContextId", "targetsBefore", "targetsAfter"],
      "properties": {
        "outcome": { "const": "success" },
        "browserContextId": { "type": "string", "minLength": 1 },
        "targetsBefore": { "type": "array", "items": { "type": "string" } },
        "targetsAfter": { "type": "array", "maxItems": 0 }
      }
    },
    "cgroupCleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "killed", "remainingPids"],
      "properties": {
        "outcome": { "const": "success" },
        "killed": { "const": true },
        "remainingPids": { "type": "array", "maxItems": 0 }
      }
    },
    "profileCleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "path", "absent"],
      "properties": {
        "outcome": { "const": "success" },
        "path": { "type": "string", "pattern": "^/tmp/wasm-sqlite-notebook-chrome-" },
        "absent": { "const": true }
      }
    },
    "serverCleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "processAbsent"],
      "properties": { "outcome": { "const": "success" }, "processAbsent": { "const": true } }
    },
    "outputCleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "path", "retained"],
      "properties": {
        "outcome": { "const": "success" },
        "path": { "type": "string", "pattern": "^/" },
        "retained": { "const": true }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionTargets", "cgroup", "browserProcesses", "profile", "server", "output"],
      "properties": {
        "sessionTargets": { "$ref": "#/$defs/sessionCleanup" },
        "cgroup": { "$ref": "#/$defs/cgroupCleanup" },
        "browserProcesses": { "$ref": "#/$defs/cleanupSuccess" },
        "profile": { "$ref": "#/$defs/profileCleanup" },
        "server": { "$ref": "#/$defs/serverCleanup" },
        "output": { "$ref": "#/$defs/outputCleanup" }
      }
    }
  }
}

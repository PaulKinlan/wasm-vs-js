{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PaulKinlan/wasm-vs-js/schemas/audio-build-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "authoritativePerformanceEvidence",
    "entryId",
    "benchmarkSlug",
    "sourceRepository",
    "sourceCommit",
    "sourceSha256",
    "fullSourceGraph",
    "manifests",
    "referenceArtifact",
    "variants",
    "build",
    "performanceClaims"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "const": "proposal-validation-only" },
    "authoritativePerformanceEvidence": { "const": false },
    "entryId": { "pattern": "^audio\\.(fft|fir|stft)\\.v1$" },
    "benchmarkSlug": { "enum": ["audio-fft", "audio-fir", "audio-stft"] },
    "sourceRepository": { "const": "https://github.com/PaulKinlan/wasm-vs-js" },
    "sourceCommit": { "pattern": "^[a-f0-9]{40}$" },
    "sourceSha256": { "$ref": "#/$defs/sha256" },
    "fullSourceGraph": {
      "type": "array",
      "minItems": 25,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "manifests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture", "input", "reference", "output"],
      "properties": {
        "fixture": { "$ref": "#/$defs/file" },
        "input": { "$ref": "#/$defs/file" },
        "reference": { "$ref": "#/$defs/file" },
        "output": { "$ref": "#/$defs/file" }
      }
    },
    "referenceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "mediaType"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "mediaType": { "const": "application/octet-stream" }
      }
    },
    "variants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["js-controlled", "wasm-linear-controlled"],
      "properties": {
        "js-controlled": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact", "artifactSha256"],
          "properties": {
            "artifact": { "$ref": "#/$defs/path" },
            "artifactSha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "wasm-linear-controlled": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "artifact",
            "artifactSha256",
            "rawBytes",
            "gzipBytes",
            "brotliBytes",
            "features"
          ],
          "properties": {
            "source": { "$ref": "#/$defs/path" },
            "artifact": { "$ref": "#/$defs/path" },
            "artifactSha256": { "$ref": "#/$defs/sha256" },
            "rawBytes": { "type": "integer", "minimum": 1 },
            "gzipBytes": { "type": "integer", "minimum": 1 },
            "brotliBytes": { "type": "integer", "minimum": 1 },
            "features": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "simd",
                "threads",
                "bulkMemory",
                "memory64",
                "exceptions",
                "initialPages",
                "maximumPages",
                "memoryGrowth"
              ],
              "properties": {
                "simd": { "const": false },
                "threads": { "const": false },
                "bulkMemory": { "const": false },
                "memory64": { "const": false },
                "exceptions": { "const": false },
                "initialPages": { "enum": [32, 64] },
                "maximumPages": { "enum": [32, 64] },
                "memoryGrowth": { "const": false }
              }
            }
          }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cwd", "command", "toolchain", "flags", "lockfiles", "environment"],
      "properties": {
        "cwd": { "const": "." },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "toolchain": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 }
            }
          }
        },
        "flags": {
          "type": "object",
          "additionalProperties": false,
          "required": ["compiler", "linker", "runtime"],
          "properties": {
            "compiler": { "type": "array", "items": { "type": "string" } },
            "linker": { "type": "array", "items": { "type": "string" } },
            "runtime": { "type": "array", "items": { "type": "string" } }
          }
        },
        "lockfiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "const": "deno.lock" },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "environment": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": { "name": { "type": "string" }, "value": { "type": "string" } }
          }
        }
      }
    },
    "performanceClaims": { "type": "array", "maxItems": 0 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": { "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/sha256" } }
    }
  }
}

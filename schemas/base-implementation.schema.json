{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wasm-vs-js.local/schemas/base-implementation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "catalog",
    "workloadId",
    "contractId",
    "variants",
    "tracksExcluded",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "const": "supplemental-controlled-implementation" },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256", "immutable"],
      "properties": {
        "id": { "const": "workload-catalog-v1" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "immutable": { "const": true }
      }
    },
    "workloadId": { "type": "string", "minLength": 1 },
    "contractId": { "type": "string", "minLength": 1 },
    "variants": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "tracksExcluded": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    }
  }
}

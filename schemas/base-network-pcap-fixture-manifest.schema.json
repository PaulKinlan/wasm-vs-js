{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PaulKinlan/wasm-vs-js/schemas/base-network-pcap-fixture-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fixtureId",
    "frozenCatalogId",
    "generator",
    "generatorVersion",
    "packetCount",
    "bytes",
    "sha256",
    "rights"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "fixtureId": { "const": "network-pcap-decode-project-generated-v1" },
    "frozenCatalogId": { "const": "network.pcap-decode.v1" },
    "generator": { "const": "benchmarks/base/network-pcap-decode/fixture.ts" },
    "generatorVersion": { "const": "pcap-project-generated-v1" },
    "packetCount": { "const": 8 },
    "bytes": { "const": 663 },
    "sha256": { "$ref": "#/$defs/sha256" },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license", "redistribution", "provenance", "grant"],
      "properties": {
        "license": { "const": "CC0-1.0" },
        "redistribution": { "const": "permitted" },
        "provenance": { "type": "string", "minLength": 1 },
        "grant": { "const": "benchmarks/base/network-pcap-decode/RIGHTS.md" }
      }
    }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PaulKinlan/wasm-vs-js/schemas/public-inspectability.schema.json",
  "title": "Public source and build inspectability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "benchmarkId",
    "evidenceStatus",
    "performanceResult",
    "source",
    "build",
    "resources"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "manifestId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 160
    },
    "benchmarkId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*$",
      "maxLength": 160
    },
    "evidenceStatus": {
      "enum": ["implementation-only-no-performance-result", "result-provenance"]
    },
    "performanceResult": { "$ref": "#/$defs/unavailable" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "treeUrl"],
      "properties": {
        "repository": { "const": "https://github.com/PaulKinlan/wasm-vs-js" },
        "commit": { "$ref": "#/$defs/gitOid" },
        "treeUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/PaulKinlan/wasm-vs-js/tree/[a-f0-9]{40}$"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "toolchains", "flags"],
      "properties": {
        "command": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "toolchains": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "flags": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 6,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/resource" }
    }
  },
  "$defs": {
    "gitOid": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"
    },
    "unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason"],
      "properties": {
        "state": { "const": "unavailable" },
        "reason": {
          "enum": ["not-collected", "not-applicable", "not-published", "unknown-provenance"]
        },
        "detail": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "availability": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": { "state": { "const": "available" } }
        },
        { "$ref": "#/$defs/unavailable" }
      ]
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "label", "availability"],
      "properties": {
        "role": {
          "enum": [
            "executed-javascript",
            "authored-wasm",
            "build-recipe",
            "lockfile",
            "build-manifest",
            "compiled-wasm"
          ]
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "availability": { "$ref": "#/$defs/availability" },
        "path": { "$ref": "#/$defs/repoPath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mediaType": {
          "type": "string",
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$",
          "maxLength": 120
        },
        "immutableUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/PaulKinlan/wasm-vs-js/blob/[a-f0-9]{40}/[A-Za-z0-9._/-]+$"
        },
        "localDownloadRoute": {
          "enum": [
            "/artifacts/sum-u32/build-manifest.9c309c49.json",
            "/artifacts/sum-u32/sum-u32.wasm"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": { "properties": { "state": { "const": "available" } } }
            },
            "required": ["availability"]
          },
          "then": { "required": ["path", "sha256", "mediaType", "immutableUrl"] },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["path"] },
                { "required": ["sha256"] },
                { "required": ["mediaType"] },
                { "required": ["immutableUrl"] },
                { "required": ["localDownloadRoute"] }
              ]
            }
          }
        }
      ]
    }
  }
}

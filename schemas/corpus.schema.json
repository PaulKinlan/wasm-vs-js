{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "corpusId",
    "experimentId",
    "permitDigest",
    "planned",
    "attempted",
    "committed",
    "failed",
    "blocked",
    "unstarted",
    "blocks",
    "status"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "corpusId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
    "experimentId": { "const": "m1-chrome-sum-u32-v1" },
    "permitDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "planned": { "const": 120 },
    "attempted": { "type": "integer", "minimum": 0, "maximum": 120 },
    "committed": { "type": "integer", "minimum": 0, "maximum": 120 },
    "failed": { "type": "integer", "minimum": 0, "maximum": 120 },
    "blocked": { "type": "integer", "minimum": 0, "maximum": 120 },
    "unstarted": { "type": "integer", "minimum": 0, "maximum": 120 },
    "blocks": {
      "type": "array",
      "maxItems": 120,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["blockId", "status", "sha256"],
        "properties": {
          "blockId": { "type": "string" },
          "status": { "enum": ["committed", "failed", "blocked"] },
          "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "status": { "enum": ["collecting", "precision-met", "cap-inconclusive", "containment-blocked"] }
  }
}

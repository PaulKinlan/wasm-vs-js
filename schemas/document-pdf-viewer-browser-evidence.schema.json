            "$ref": "#/$defs/result"
          }
        },
        "rejection": {
          "oneOf": [
            {
              "$ref": "#/$defs/rejection"
            },
            {
              "type": "null"
            }
          ]
        },
        "causal": {
          "$ref": "#/$defs/causal"
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }

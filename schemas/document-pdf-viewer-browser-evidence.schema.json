        "algorithm": {
          "const": "SHA-256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "base64": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "enum": [
            "resource-key",
            "font-key",
            "font-nesting"
          ]
        },
        "originalSha256": {
          "$ref": "#/$defs/sha256"
        },
        "mutatedSha256": {
          "$ref": "#/$defs/sha256"
        },
        "changedOffset": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "detail",
        "sessionId",
        "targetId"
      ],
      "properties": {
        "kind": {
          "enum": [
            "instrumentation-ready",
            "worker-created",
            "worker-posted",
            "worker-held",
            "worker-released",
            "worker-terminated",
            "wrong-token-dispatched",
            "stale-result-error-dispatched",
            "worker-instrumentation-ready",
            "fetched-body",
            "resource-mutation",
            "digest-input",
            "wasm-instantiated",
            "wasm-module-instantiated"
          ]
        },
        "detail": {
          "$ref": "#/$defs/eventDetail"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "targetId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "targetId",
        "targetType",
        "type",
        "arguments"

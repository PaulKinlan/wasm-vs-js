          "$ref": "#/$defs/sha256"
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "gitBlob": {
          "$ref": "#/$defs/git"
        },
        "cdpEncoding": {
          "enum": [
            "base64",
            "utf8"
          ]
        }

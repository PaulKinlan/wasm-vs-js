          "$ref": "#/$defs/emptyPidCleanup"
        },
        "profile": {
          "$ref": "#/$defs/profileCleanup"
        },
        "server": {
          "$ref": "#/$defs/serverCleanup"
        },
        "output": {
          "$ref": "#/$defs/outputCleanup"
        }

        "lineNumber",
        "columnNumber"
      ],
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "targetId": {
          "type": "string"
        },
        "targetType": {
          "enum": [
            "page",
            "worker"
          ]
        },
        "text": {
          "type": "string"
        },
        "lineNumber": {
          "type": "integer",
          "minimum": 0
        },
        "columnNumber": {
          "type": "integer",
          "minimum": 0
        }

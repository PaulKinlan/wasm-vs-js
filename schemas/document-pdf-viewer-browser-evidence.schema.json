          "minItems": 3,
          "items": {
            "$ref": "#/$defs/network"
          }
        },
        "executedSources": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/executedSource"
          }
        },
        "accessibility": {
          "$ref": "#/$defs/accessibility"
        },
        "screenshot": {
          "$ref": "#/$defs/screenshot"
        }
      }

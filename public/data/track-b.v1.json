      "variants": [
        {
          "key": "asc-ikj",
          "baseline": "asc",
          "equivalence": "bit-identical",
          "optimizationLog": "Loop interchange i/j/k -> i/k/j. The baseline reads B down a column in the innermost loop, touching a separate 64-byte line per iteration; interchanging streams B along a row instead, so lines are fully used and the prefetcher can work. Costs the register accumulator — the running sum lives in OUT, so each inner step is a load/store pair. Bit-identical: for any fixed (i,j) the terms are still added in ascending t with f32 rounding after each add, so no accumulation order changes. Measured 1.28x over the asc baseline (Deno, arm64 macOS, 128^3, 200 iterations).",
          "maxUlpDeviation": null,
          "maxRelativeDeviation": null,
          "declaredTolerance": null
        },
        {
          "key": "asc-tiled",
          "baseline": "asc",
          "equivalence": "bit-identical",
          "optimizationLog": "Classic i/j cache blocking into 32x32 panels; the k loop is deliberately left unblocked so no accumulation order changes. Per-panel working set is 16 KiB of A plus 16 KiB of B against 64 KiB for the whole of B untiled. Measured 1.02x — effectively neutral. At 128^3 the entire B matrix is 64 KiB and already fits in this machine's L1d, so there is no capacity miss for blocking to remove. The tile size is tuned to one machine and this result should not be generalised to larger shapes.",
          "maxUlpDeviation": null,
          "maxRelativeDeviation": null,
          "declaredTolerance": null
        },
        {
          "key": "dart-o2",
          "baseline": "dart",
          "equivalence": "bit-identical",
          "optimizationLog": "-O2: -O1 plus minification; documented safe for all programs. Bit-identical to the pinned strict-f32 oracle.",
          "maxUlpDeviation": null,
          "maxRelativeDeviation": null,
          "declaredTolerance": null
        },
        {
          "key": "dart-o3",
          "baseline": "dart",
          "equivalence": "bit-identical",
          "optimizationLog": "-O3: -O2 plus omits implicit type checks. Non-default diagnostic mode. Bit-identical to the pinned strict-f32 oracle.",
          "maxUlpDeviation": null,
          "maxRelativeDeviation": null,
          "declaredTolerance": null
        },
        {
          "key": "dart-o4",
          "baseline": "dart",
          "equivalence": "bit-identical",
          "optimizationLog": "-O4: more aggressive than -O3 under the same assumptions, input-data sensitive. Non-default diagnostic mode. Bit-identical to the pinned strict-f32 oracle.",
          "maxUlpDeviation": null,
